{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axo.leostera.dev/v1/local-rpc.schema.json",
  "title": "AxoMac to axod local JSON-RPC v1",
  "$defs": {
    "Call": {
      "oneOf": [
        {"$ref":"#/$defs/TimerCreateCall"},
        {"$ref":"#/$defs/TimerListCall"},
        {"$ref":"#/$defs/TimerCancelCall"},
        {
          "$ref": "#/$defs/NegotiateCall"
        },
        {
          "$ref": "#/$defs/HealthCall"
        },
        { "$ref": "#/$defs/PermissionsCall" },
        { "$ref": "#/$defs/PermissionRequestCall" },
        {
          "$ref": "#/$defs/RemoteAccessStatusCall"
        },
        {
          "$ref": "#/$defs/RemoteAccessConnectCall"
        },
        { "$ref": "#/$defs/RemoteAccessUnlinkCall" },
        {
          "$ref": "#/$defs/ConfigGetCall"
        },
        {
          "$ref": "#/$defs/ConfigSetCall"
        },
        {
          "$ref": "#/$defs/SessionListCall"
        },
        {
          "$ref": "#/$defs/SessionCreateCall"
        },
        {
          "$ref": "#/$defs/SessionCloseCall"
        },
        {
          "$ref": "#/$defs/SessionRenameCall"
        },
        {
          "$ref": "#/$defs/LayoutSetCall"
        },
        {
          "$ref": "#/$defs/ShellCreateCall"
        },
        {
          "$ref": "#/$defs/ShellCloseCall"
        },
        {
          "$ref": "#/$defs/EventsStreamCall"
        },
        {
          "$ref": "#/$defs/TerminalInputCall"
        },
        {
          "$ref": "#/$defs/TerminalResizeCall"
        },
        {
          "$ref": "#/$defs/ClientViewportSetCall"
        },
        {
          "$ref": "#/$defs/ClientViewportSetV2Call"
        },
        {
          "$ref": "#/$defs/ShellBusyCall"
        }
      ]
    },
    "TimerCreateCall": {"allOf":[{"$ref":"#/$defs/BaseCall"},{"required":["params"],"properties":{"method":{"const":"axo.session.timer.create"},"params":{"type":"object","additionalProperties":false,"required":["sessionId","fromSessionId","text","timing"],"properties":{"sessionId":{"$ref":"common.schema.json#/$defs/SessionId"},"fromSessionId":{"$ref":"common.schema.json#/$defs/SessionId"},"text":{"type":"string","minLength":1,"maxLength":16000},"delivery":{"enum":["followUp","steer","turn"]},"timing":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","milliseconds"],"properties":{"kind":{"const":"after"},"milliseconds":{"type":"integer","minimum":1,"maximum":2592000000}}},{"type":"object","additionalProperties":false,"required":["kind","milliseconds"],"properties":{"kind":{"const":"interval"},"milliseconds":{"type":"integer","minimum":1000,"maximum":86400000}}}]}}}}}]},
    "TimerListCall": {"allOf":[{"$ref":"#/$defs/BaseCall"},{"required":["params"],"properties":{"method":{"const":"axo.session.timer.list"},"params":{"type":"object","additionalProperties":false,"required":["fromSessionId"],"properties":{"fromSessionId":{"$ref":"common.schema.json#/$defs/SessionId"}}}}}]},
    "TimerCancelCall": {"allOf":[{"$ref":"#/$defs/BaseCall"},{"required":["params"],"properties":{"method":{"const":"axo.session.timer.cancel"},"params":{"type":"object","additionalProperties":false,"required":["fromSessionId","timerId"],"properties":{"fromSessionId":{"$ref":"common.schema.json#/$defs/SessionId"},"timerId":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}}}}}]},
    "NegotiateCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.protocol.negotiate"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocolVersion"
              ],
              "properties": {
                "protocolVersion": {
                  "const": 2
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "BaseCall": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/RpcId"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "PermissionsCall": {
      "allOf": [ {"$ref":"#/$defs/BaseCall"}, {"properties":{"method":{"const":"axo.daemon.permissions"},"params":{"type":"object","maxProperties":0}}} ]
    },
    "PermissionRequestCall": {
      "allOf": [ {"$ref":"#/$defs/BaseCall"}, {"required":["params"],"properties":{"method":{"const":"axo.daemon.permissions.request"},"params":{"type":"object","required":["target"],"additionalProperties":false,"properties":{"target":{"enum":["finder","systemEvents"]}}}}} ]
    },
    "HealthCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.daemon.health"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          },
          "not": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RemoteAccessStatusCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.relay.status"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RemoteAccessUnlinkCall": {
      "allOf": [
        { "$ref": "#/$defs/BaseCall" },
        { "properties": { "method": { "const": "axo.relay.unlink" }, "params": { "type": "object", "maxProperties": 0 } } }
      ],
      "unevaluatedProperties": false
    },
    "RemoteAccessConnectCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.relay.connect"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ConfigKey": {
      "type": "string",
      "enum": ["agent.command", "shell.command", "sessions.idleMinutes", "sessions.idleLimit"]
    },
    "ConfigGetCall": {
      "allOf": [
        { "$ref": "#/$defs/BaseCall" },
        {
          "properties": {
            "method": { "const": "axo.config.get" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key"],
              "properties": { "key": { "$ref": "#/$defs/ConfigKey" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": ["params"]
    },
    "ConfigSetCall": {
      "allOf": [
        { "$ref": "#/$defs/BaseCall" },
        {
          "properties": {
            "method": { "const": "axo.config.set" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": {
                "key": { "$ref": "#/$defs/ConfigKey" },
                "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": ["params"]
    },
    "SessionListCall": {
      "$ref": "#/$defs/NoParamsSessionListCall"
    },
    "NoParamsSessionListCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.session.list"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SessionCreateCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.session.create"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "not": { "properties": { "folder": {}, "like": {} }, "required": ["folder", "like"] },
              "description": "Optional explicit name, set before startup. Folder and like are mutually exclusive; neither means home. The agent is fixed for the Session's life; pi when absent (RFD0072).",
              "properties": {
                "folder": { "type": "string", "minLength": 1 },
                "like": { "$ref": "common.schema.json#/$defs/SessionId" },
                "name": { "type": "string", "minLength": 1, "maxLength": 80, "description": "1–80 UTF-16 units, without controls or surrounding whitespace. Sets the manual name." },
                "agent": { "enum": ["pi", "codex", "opencode", "claude-code"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SessionCloseCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.session.close"
            },
            "params": {
              "$ref": "#/$defs/SessionIdParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "SessionRenameCall": {
      "allOf": [
        { "$ref": "#/$defs/BaseCall" },
        {
          "properties": {
            "method": { "const": "axo.session.rename" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sessionId", "name"],
              "properties": {
                "sessionId": { "$ref": "common.schema.json#/$defs/SessionId" },
                "name": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": ["params"]
    },
    "LayoutSetCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.session.layout.set"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "layout"
              ],
              "properties": {
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "layout": {
                  "$ref": "common.schema.json#/$defs/Layout"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "ShellCreateCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.shell.create"
            },
            "params": {
              "$ref": "#/$defs/SessionIdParams"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "ShellCloseCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.shell.close"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "shellId"
              ],
              "properties": {
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "EventsStreamCall": {
      "description": "Opens a stream on a connection of its own, as its first request. axod answers with EventsStreamResult, then sends each batch as an EventsNotification until the connection closes. The subscription lives as long as the connection; after a subscription.lagged event axod ends the stream.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.session.events.stream"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "includeTerminalOutput": {
                  "type": "boolean",
                  "default": true,
                  "description": "Catalog subscribers pass false to receive only catalog events (session, focus and shell activity); terminal output and Pi stream events are excluded."
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "TerminalInputCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.terminal.input"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "shellId",
                "sequence",
                "data"
              ],
              "properties": {
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "minLength": 4,
                  "maxLength": 65536
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "TerminalResizeCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.terminal.resize"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "shellId",
                "rows",
                "columns"
              ],
              "properties": {
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "columns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "ClientViewportSetV2Call": {
      "description": "Native renderer metrics and integer logical split allocation; requires advertised viewport.set.v2.",
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.client.viewport.set.v2"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "terminalArea",
                "backingScale",
                "cell",
                "padding",
                "dividerThickness",
                "rasterization"
              ],
              "properties": {
                "terminalArea": {
                  "description": "The area panes split, in points.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100000
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100000
                    }
                  }
                },
                "backingScale": {
                  "description": "Device pixels per point.",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 8
                },
                "cell": {
                  "description": "One terminal cell, in device pixels.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    }
                  }
                },
                "padding": {
                  "description": "Ghostty window padding, in points.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "top",
                    "bottom",
                    "left",
                    "right"
                  ],
                  "properties": {
                    "top": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "bottom": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "left": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "right": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  }
                },
                "dividerThickness": {
                  "description": "Points between split panes.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "rasterization": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "origin",
                    "paddingPixels",
                    "splitRounding"
                  ],
                  "properties": {
                    "origin": {
                      "type": "object", "additionalProperties": false, "required": ["x", "y"],
                      "properties": {
                        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
                        "y": { "type": "number", "minimum": -100000, "maximum": 100000 }
                      }
                    },
                    "paddingPixels": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "top",
                        "bottom",
                        "left",
                        "right"
                      ],
                      "properties": {
                        "top": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8000
                        },
                        "bottom": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8000
                        },
                        "left": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8000
                        },
                        "right": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 8000
                        }
                      }
                    },
                    "splitRounding": {
                      "const": "logicalFloor"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "ClientViewportSetCall": {
      "description": "Where the client draws terminals. The latest client to report a viewport sizes every pane no client is attached to, and new panes start at that size.",
      "allOf": [
        { "$ref": "#/$defs/BaseCall" },
        {
          "properties": {
            "method": { "const": "axo.client.viewport.set" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminalArea", "backingScale", "cell", "padding", "dividerThickness"],
              "properties": {
                "terminalArea": {
                  "description": "The area panes split, in points.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["width", "height"],
                  "properties": {
                    "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
                    "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 }
                  }
                },
                "backingScale": { "description": "Device pixels per point.", "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
                "cell": {
                  "description": "One terminal cell, in device pixels.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["width", "height"],
                  "properties": {
                    "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
                    "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
                  }
                },
                "padding": {
                  "description": "Ghostty window padding, in points.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["top", "bottom", "left", "right"],
                  "properties": {
                    "top": { "type": "integer", "minimum": 0, "maximum": 1000 },
                    "bottom": { "type": "integer", "minimum": 0, "maximum": 1000 },
                    "left": { "type": "integer", "minimum": 0, "maximum": 1000 },
                    "right": { "type": "integer", "minimum": 0, "maximum": 1000 }
                  }
                },
                "dividerThickness": { "description": "Points between split panes.", "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": ["params"]
    },
    "SessionIdParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId"
      ],
      "properties": {
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        }
      }
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jsonrpc",
            "id",
            "result"
          ],
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/RpcId"
            },
            "result": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jsonrpc",
            "id",
            "error"
          ],
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/RpcId"
            },
            "error": {
              "$ref": "common.schema.json#/$defs/RpcError"
            }
          }
        }
      ]
    },
    "LocalNotification": {
      "$ref": "events.schema.json#/$defs/Notification"
    },
    "NegotiateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "methods"
      ],
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "HealthResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildNumber",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "buildNumber": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "running"
        },
        "ready": {
          "description": "Whether axod has finished starting: the Pis it started at launch are up, failed, or took too long. Absent from an axod that predates it.",
          "type": "boolean"
        },
        "developerTools": {
          "enum": [
            "granted",
            "denied",
            "notAsked"
          ]
        }
      }
    },
    "RemoteAccessStatusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "connectedSinceUnixMillis",
        "hostName",
        "hostKind",
        "lastError"
      ],
      "properties": {
        "state": {
          "enum": ["connecting", "connected", "disconnected"]
        },
        "connectedSinceUnixMillis": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostKind": {
          "enum": ["macos", "linux", "windows"]
        },
        "lastError": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "linked": { "type": "boolean" },
        "accountId": { "type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$" }
      }
    },
    "RemoteAccessUnlinkResult": {
      "type": "object", "additionalProperties": false,
      "required": ["unlinked"], "properties": { "unlinked": { "const": true } }
    },
    "RemoteAccessConnectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested"],
      "properties": {
        "requested": {
          "type": "boolean"
        }
      }
    },
    "ConfigValueResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/ConfigKey" },
        "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "SessionListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/LocalSession"
          }
        },
        "resumeSessionId": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/SessionId" },
            { "type": "null" }
          ]
        }
      }
    },
    "SessionCreateResult": {
      "$ref": "common.schema.json#/$defs/LocalSession"
    },
    "SessionRenameResult": { "$ref": "common.schema.json#/$defs/LocalSession" },
    "SessionCloseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archivedSessionId"
      ],
      "properties": {
        "archivedSessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        }
      }
    },
    "ShellCreateResult": {
      "$ref": "common.schema.json#/$defs/LocalShell"
    },
    "ShellCloseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archivedShellId",
        "archivedSessionId"
      ],
      "properties": {
        "archivedShellId": {
          "$ref": "common.schema.json#/$defs/ShellId"
        },
        "archivedSessionId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LayoutSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved"
      ],
      "properties": {
        "saved": {
          "const": true
        }
      }
    },
    "EventsStreamResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptionId"
      ],
      "properties": {
        "subscriptionId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "TerminalInputResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "sequence"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ShellBusyCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.shell.busy"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "shellId"
              ],
              "properties": {
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "ShellBusyResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether closing the shell would interrupt work: a foreground job other than the shell (terminal panes) or a Pi turn in progress (Pi panes).",
      "required": [
        "busy",
        "foregroundProcess"
      ],
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "foregroundProcess": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255,
          "description": "Foreground process name, a presentation hint only."
        }
      }
    },
    "ClientViewportSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": { "accepted": { "const": true } }
    },
    "TerminalResizeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rows",
        "columns"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "EventsNotification": {
      "description": "One batch of events axod pushes on an events stream, in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "axo.session.events" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events"],
          "properties": {
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "events.schema.json#/$defs/LocalEvent" }
            }
          }
        }
      }
    }
  }
}
