{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axo.leostera.dev/v1/pairing.schema.json",
  "title": "Axo v1 one-time host pairing HTTP contracts",
  "$defs": {
    "PairingCode": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
    },
    "HostPairingCreateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "expiresAt"],
      "properties": {
        "code": { "$ref": "#/\u0024defs/PairingCode" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "HostPairingRedeemRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "hostId", "hostGeneration", "credentialId", "credential", "label", "hostKind"],
      "properties": {
        "code": { "$ref": "#/\u0024defs/PairingCode" },
        "hostId": { "type": "string", "format": "uuid" },
        "hostGeneration": { "type": "string", "format": "uuid" },
        "credentialId": { "type": "string", "format": "uuid" },
        "credential": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hostKind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "HostPairingRedeemResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linked", "accountId", "hostId", "hostGeneration", "credentialId", "linkedAt"],
      "properties": {
        "linked": { "const": true },
        "accountId": { "type": "string", "format": "uuid" },
        "hostId": { "type": "string", "format": "uuid" },
        "hostGeneration": { "type": "string", "format": "uuid" },
        "credentialId": { "type": "string", "format": "uuid" },
        "linkedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
