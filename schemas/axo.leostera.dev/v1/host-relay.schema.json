{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axo.leostera.dev/v1/host-relay.schema.json",
  "title": "Axo protocol v1 host registration and remote RPC",
  "$defs": {
    "Call": {
      "oneOf": [
        {
          "$ref": "#/$defs/HostRegisterCall"
        },
        {
          "$ref": "#/$defs/HostHeartbeatCall"
        },
        {
          "$ref": "#/$defs/SessionPublishCall"
        },
        {
          "$ref": "#/$defs/HostListCall"
        },
        {
          "$ref": "#/$defs/SessionsListCall"
        },
        {
          "$ref": "#/$defs/HostSubscribeCall"
        },
        {
          "$ref": "#/$defs/HostUnsubscribeCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionCreateCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionCloseCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionRenameCall"
        },
        {
          "$ref": "#/$defs/RemoteShellCreateCall"
        },
        {
          "$ref": "#/$defs/RemoteShellCloseCall"
        },
        {
          "$ref": "#/$defs/RemoteLayoutSetCall"
        },
        {
          "$ref": "#/$defs/RemoteTerminalInputCall"
        },
        {
          "$ref": "#/$defs/RemotePromptCall"
        },
        {
          "$ref": "#/$defs/RemoteKeyCall"
        },
        {
          "$ref": "#/$defs/RemoteStopCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionRestartCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionCommandsCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionModelsCall"
        },
        {
          "$ref": "#/$defs/RemoteSessionModelSetCall"
        },
        {
          "$ref": "#/$defs/RemoteTerminalResizeCall"
        }
      ]
    },
    "BaseCall": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/RpcId"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "HostRegisterCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.register"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocolVersion",
                "hostId",
                "hostGeneration",
                "label",
                "hostKind",
                "sessions"
              ],
              "properties": {
                "protocolVersion": {
                  "const": 2
                },
                "hostId": {
                  "$ref": "common.schema.json#/$defs/HostId"
                },
                "hostGeneration": {
                  "$ref": "common.schema.json#/$defs/HostGeneration"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "hostKind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "capabilities": {
                  "$ref": "common.schema.json#/$defs/HostCapabilities"
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/SessionSnapshot"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "HostHeartbeatCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.heartbeat"
            },
            "params": {
              "$ref": "common.schema.json#/$defs/HostRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "SessionPublishCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.sessions.publish"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hostId",
                "hostGeneration",
                "sessions"
              ],
              "properties": {
                "hostId": {
                  "$ref": "common.schema.json#/$defs/HostId"
                },
                "hostGeneration": {
                  "$ref": "common.schema.json#/$defs/HostGeneration"
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/SessionSnapshot"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "HostListCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.list"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SessionsListCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.sessions.list"
            },
            "params": {
              "$ref": "common.schema.json#/$defs/HostRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "HostSubscribeCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.subscribe"
            },
            "params": {
              "$ref": "common.schema.json#/$defs/HostRef"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "HostUnsubscribeCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.host.unsubscribe"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subscriptionId"
              ],
              "properties": {
                "subscriptionId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteSessionCreateCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.create"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "like": {
                  "$ref": "common.schema.json#/$defs/SessionId",
                  "description": "An open Session whose folder the new one starts in; the Mac's home directory without it."
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteSessionCloseCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.close"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteShellCreateCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.shell.create"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteShellCloseCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.shell.close"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "shellId"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteLayoutSetCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.layout.set"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "layout"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "layout": {
                  "$ref": "common.schema.json#/$defs/Layout"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteTerminalInputCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.terminal.input"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "shellId",
                "sequence",
                "data"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "data": {
                  "type": "string",
                  "contentEncoding": "base64",
                  "minLength": 4,
                  "maxLength": 65536
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemotePromptCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.prompt"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "text"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "text": {
                  "description": "May be empty when the prompt has attachments.",
                  "type": "string",
                  "maxLength": 16000
                },
                "commandId": {
                  "description": "The Session's Pi takes the prompt at most once, after a receipt (RFD0024).",
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "attachments": {
                  "description": "Assets (RFD0030) the Mac fetches and checks before the prompt reaches Pi.",
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "$ref": "common.schema.json#/$defs/Attachment"
                  }
                },
                "delivery": {
                  "description": "When a working Pi takes it: once the run ends (followUp, the default), within it (steer), or at once, stopping it (interrupt). Either way it is in the Session's log before it is accepted (RFD0033).",
                  "type": "string",
                  "enum": [
                    "followUp",
                    "steer",
                    "interrupt"
                  ]
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "text": {
                      "minLength": 1
                    }
                  }
                },
                {
                  "required": [
                    "attachments"
                  ],
                  "properties": {
                    "attachments": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteStopCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.stop"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId"
              ],
              "anyOf": [
                { "required": ["turnId"], "properties": { "turnId": true } },
                { "required": ["seen"], "properties": { "seen": true } },
                { "required": ["commandIds"], "properties": { "commandIds": { "minItems": 1 } } }
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "turnId": {
                  "description": "The entry id of a user record of the run the client showed running (RFD0024).",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                },
                "seen": {
                  "description": "The newest entry the client held: of the running run, however long, once its records reached the client.",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                },
                "commandIds": {
                  "description": "The client's own prompts it shows as sent or queued: they name a run before any of its records reach the client.",
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteKeyCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.key"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "key"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "key": {
                  "enum": [
                    "escape",
                    "enter"
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteTerminalResizeCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.terminal.resize"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "shellId",
                "rows",
                "columns"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "shellId": {
                  "$ref": "common.schema.json#/$defs/ShellId"
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "columns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "Response": {
      "$ref": "local-rpc.schema.json#/$defs/Response"
    },
    "HostRegisterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "$ref": "common.schema.json#/$defs/HostSnapshot"
        }
      }
    },
    "HeartbeatResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledged",
        "lastSeenAt"
      ],
      "properties": {
        "acknowledged": {
          "const": true
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SessionPublishResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storedAt"
      ],
      "properties": {
        "storedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "HostListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/HostSnapshot"
          }
        }
      }
    },
    "SessionsListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "sessions"
      ],
      "properties": {
        "host": {
          "$ref": "common.schema.json#/$defs/HostSnapshot"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/SessionSnapshot"
          }
        }
      }
    },
    "HostSubscribeResult": {
      "$ref": "local-rpc.schema.json#/$defs/SubscribeResult"
    },
    "RemoteSessionCreateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session"
      ],
      "properties": {
        "session": {
          "$ref": "common.schema.json#/$defs/SessionSnapshot"
        }
      }
    },
    "RemoteSessionCloseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "sessionId"
      ],
      "properties": {
        "closed": {
          "const": true
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        }
      }
    },
    "RemoteShellCreateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "sessionId",
        "shellId"
      ],
      "properties": {
        "hostId": {
          "$ref": "common.schema.json#/$defs/HostId"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "shellId": {
          "$ref": "common.schema.json#/$defs/ShellId"
        }
      }
    },
    "RemoteShellCloseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "hostId",
        "sessionId",
        "shellId"
      ],
      "properties": {
        "closed": {
          "const": true
        },
        "hostId": {
          "$ref": "common.schema.json#/$defs/HostId"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "shellId": {
          "$ref": "common.schema.json#/$defs/ShellId"
        }
      }
    },
    "RemoteLayoutSetResult": {
      "$ref": "local-rpc.schema.json#/$defs/LayoutSetResult"
    },
    "RemoteTerminalInputResult": {
      "$ref": "local-rpc.schema.json#/$defs/TerminalInputResult"
    },
    "RemoteTerminalResizeResult": {
      "$ref": "local-rpc.schema.json#/$defs/TerminalResizeResult"
    },
    "RemoteSessionRenameCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.rename"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId",
                "name"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ]
    },
    "RemoteSessionRenameResult": {
      "$ref": "local-rpc.schema.json#/$defs/LayoutSetResult"
    },
    "RemoteSessionRestartCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.restart"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "sessionId"
              ],
              "properties": {
                "target": {
                  "$ref": "common.schema.json#/$defs/HostRef"
                },
                "sessionId": {
                  "$ref": "common.schema.json#/$defs/SessionId"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "params"
      ],
      "description": "Restarts the Session's Pi, running, stuck or gone, on the same conversation; a turn it is running stops (RFD0033)."
    },
    "RemoteSessionCommandsCall": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseCall"
        },
        {
          "properties": {
            "method": {
              "const": "axo.remote.session.commands"
            },
            "params": {
              "type": "object",
