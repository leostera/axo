{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axo.leostera.dev/v1/events.schema.json",
  "title": "Axo protocol v1 local events",
  "$defs": {
    "LocalEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/SessionSnapshotEvent"
        },
        {
          "$ref": "#/$defs/SessionRemovedEvent"
        },
        {
          "$ref": "#/$defs/ShellActivityEvent"
        },
        {
          "$ref": "#/$defs/TerminalOutputEvent"
        },
        {
          "$ref": "#/$defs/SessionFocusEvent"
        },
        {
          "$ref": "#/$defs/RelayStatusEvent"
        },
        {
          "$ref": "#/$defs/SubscriptionLaggedEvent"
        },
        {
          "$ref": "#/$defs/DaemonReadyEvent"
        }
      ]
    },
    "Notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "axo.session.event"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscriptionId",
            "event"
          ],
          "properties": {
            "subscriptionId": {
              "type": "string",
              "format": "uuid"
            },
            "event": {
              "$ref": "#/$defs/LocalEvent"
            }
          }
        }
      }
    },
    "SessionSnapshotEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "session"
      ],
      "properties": {
        "type": {
          "const": "session.snapshot"
        },
        "session": {
          "$ref": "common.schema.json#/$defs/LocalSession"
        }
      }
    },
    "RelayStatusEvent": {
      "description": "Remote-access connection state changed; carries the same value as axo.relay.status.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status"
      ],
      "properties": {
        "type": {
          "const": "relay.status"
        },
        "status": {
          "$ref": "local-rpc.schema.json#/$defs/RemoteAccessStatusResult"
        }
      }
    },
    "SessionFocusEvent": {
      "description": "Axod asks clients to show this session, for example after /resume.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId"
      ],
      "properties": {
        "type": {
          "const": "session.focus"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        }
      }
    },
    "DaemonReadyEvent": {
      "description": "Axod has finished starting: the Pis it started at launch are up, failed, or took too long. Sent once per axod; health's ready says the same.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "daemon.ready"
        }
      }
    },
    "SubscriptionLaggedEvent": {
      "description": "The subscription queue overflowed and earlier events were discarded; resynchronize from a fresh listing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "subscription.lagged"
        }
      }
    },
    "SessionRemovedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId"
      ],
      "properties": {
        "type": {
          "const": "session.removed"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        }
      }
    },
    "ShellActivityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "shellId",
        "activity"
      ],
      "properties": {
        "type": {
          "const": "shell.activity"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "shellId": {
          "$ref": "common.schema.json#/$defs/ShellId"
        },
        "activity": {
          "enum": [
            "started",
            "exited",
            "attached",
            "detached"
          ]
        }
      }
    },
    "TerminalOutputEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sessionId",
        "shellId",
        "sequence",
        "data"
      ],
      "properties": {
        "type": {
          "const": "terminal.output"
        },
        "sessionId": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "shellId": {
          "$ref": "common.schema.json#/$defs/ShellId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 4,
          "maxLength": 131072
        }
      }
    }
  }
}
