{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axo.leostera.dev/v1/common.schema.json",
  "title": "Axo protocol v1 common values",
  "$defs": {
    "RpcId": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      ]
    },
    "HostId": { "type": "string", "format": "uuid" },
    "HostGeneration": { "type": "string", "format": "uuid" },
    "SessionId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "ShellId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "SplitDirection": { "type": "string", "enum": ["right", "down"] },
    "Layout": {
      "oneOf": [
        { "$ref": "#/$defs/PaneLayout" },
        { "$ref": "#/$defs/SplitLayout" }
      ]
    },
    "PaneLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "shellId"],
      "properties": {
        "kind": { "const": "pane" },
        "shellId": { "$ref": "#/$defs/ShellId" }
      }
    },
    "SplitLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "direction", "ratio", "first", "second"],
      "properties": {
        "kind": { "const": "split" },
        "id": { "type": "string", "format": "uuid" },
        "direction": { "$ref": "#/$defs/SplitDirection" },
        "ratio": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
        "first": { "$ref": "#/$defs/Layout" },
        "second": { "$ref": "#/$defs/Layout" }
      }
    },
    "HostRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "hostGeneration"],
      "properties": {
        "hostId": { "$ref": "#/$defs/HostId" },
        "hostGeneration": { "$ref": "#/$defs/HostGeneration" }
      }
    },
    "LocalShell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "processId", "initialPwd", "ptyDevice", "attachSocketPath", "available", "availabilityReason"],
      "properties": {
        "id": { "$ref": "#/$defs/ShellId" },
        "paneId": { "anyOf": [{ "$ref": "#/$defs/HostId" }, { "type": "null" }] },
        "role": { "type": "string", "enum": ["pi", "terminal"] },
        "processId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "initialPwd": { "type": "string", "minLength": 1 },
        "ptyDevice": { "type": "string" },
        "attachSocketPath": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "availabilityReason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "LocalSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "initialPwd", "shells", "manualName"],
      "properties": {
        "id": { "$ref": "#/$defs/SessionId" },
        "sessionUuid": { "$ref": "#/$defs/HostId" },
        "piSessionFile": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "piSessionId": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] },
        "workspaceId": { "anyOf": [{ "$ref": "#/$defs/HostId" }, { "type": "null" }] },
        "workspaceName": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "manualName": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "null" }] },
        "emoji": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 64 }, { "type": "null" }] },
        "lastMessageAt": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "createdAt": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["starting", "ready", "working", "needsAttention", "unavailable"] },
        "initialPwd": { "type": "string", "minLength": 1 },
        "shells": { "type": "array", "items": { "$ref": "#/$defs/LocalShell" } },
        "layout": { "anyOf": [{ "$ref": "#/$defs/Layout" }, { "type": "null" }] }
      }
    },
    "SessionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "sessionId", "shells", "layout", "updatedAt"],
      "properties": {
        "hostId": { "$ref": "#/$defs/HostId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "sessionUuid": { "$ref": "#/$defs/HostId" },
        "workspaceId": { "anyOf": [{ "$ref": "#/$defs/HostId" }, { "type": "null" }] },
        "workspaceName": { "anyOf": [{ "type": "string", "maxLength": 80 }, { "type": "null" }] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "emoji": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 16 }, { "type": "null" }] },
        "status": { "type": "string", "enum": ["starting", "ready", "working", "needsAttention", "unavailable"] },
        "hasAgent": { "type": "boolean" },
        "shells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shellId"],
            "properties": { "shellId": { "$ref": "#/$defs/ShellId" } }
          }
        },
        "layout": { "anyOf": [{ "$ref": "#/$defs/Layout" }, { "type": "null" }] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessageAt": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "createdAt": { "type": "integer", "minimum": 0 }
      }
    },
    "HostCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "enum": ["agent.pi", "terminal.pty", "workspace.filesystem"] },
        "version": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "HostCapabilities": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/HostCapability" }
    },
    "HostSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "hostGeneration", "label", "hostKind", "status", "stale", "lastSeenAt", "sessions"],
      "properties": {
        "hostId": { "$ref": "#/$defs/HostId" },
        "hostGeneration": { "$ref": "#/$defs/HostGeneration" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hostKind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "capabilities": { "$ref": "#/$defs/HostCapabilities" },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "stale": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/SessionSnapshot" } }
      }
    },
    "RpcError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string", "minLength": 1 },
        "data": {}
      }
    }
  }
}
