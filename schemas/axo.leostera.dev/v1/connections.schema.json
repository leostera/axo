        "removed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "removed"
      ],
      "additionalProperties": false
    },
    "LogCall": {
      "description": "Reads the account's call log, newest first. Sent by axod on behalf of a Session; the account answers through the host's HostDO.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
