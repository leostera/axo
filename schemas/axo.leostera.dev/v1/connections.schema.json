            },
            "service": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                {
                  "type": "string",
                  "pattern": "^apps\\.[a-z][a-z0-9_]{0,31}$"
                }
              ]
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "LogResult": {
      "description": "The result of axo.connections.log.",
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "callId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "sessionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hostId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "service": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^apps\\.[a-z][a-z0-9_]{0,31}$"
                  }
                ]
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "targetHostId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "ok",
                  "error",
                  "unknown"
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "input": {}
            },
            "required": [
              "callId",
              "at",
              "sessionId",
              "hostId",
              "service",
              "tool",
              "targetHostId",
              "durationMs",
              "outcome",
              "error",
              "input"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "records"
      ],
      "additionalProperties": false
    },
    "BashCall": {
      "description": "Runs one non-interactive command on a Mac as axod's user. Sent by the account down the Mac's relay socket; the Mac refuses one for another account, and a reply on a later socket is ignored.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "type": "string",
          "const": "axo.connections.bash"
        },
        "params": {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "callId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "cwd": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^\\/"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            }
          },
          "required": [
            "accountId",
            "callId",
            "command"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "BashResult": {
      "description": "A command's exit, its output (each stream kept to 1 MiB, then marked truncated) and how long it ran.",
      "type": "object",
      "properties": {
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdoutTruncated": {
          "type": "boolean"
        },
        "stderrTruncated": {
          "type": "boolean"
        },
        "timedOut": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "exitCode",
        "signal",
        "stdout",
        "stderr",
        "stdoutTruncated",
        "stderrTruncated",
        "timedOut",
        "durationMs"
      ],
      "additionalProperties": false
    }
  }
}
