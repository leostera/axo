                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "state": {
                  "type": "string",
                  "enum": [
