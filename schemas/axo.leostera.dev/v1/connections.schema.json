                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "needsSignIn"
                  ]
                },
                "accounts": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "account": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 320
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "ready",
                          "needsSignIn"
