{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axo.leostera.dev/v1/connections.schema.json",
  "title": "Axo connections and the relay transport they need (RFD0016)",
  "$defs": {
    "TransportFragment": {
      "description": "One piece of a relay message larger than one 64 KiB frame. The receiver joins the base64-decoded `data` of fragments 0 to count - 1 and parses the result as one message. Every fragment but the last carries exactly 46080 bytes; a reassembled message is at most 16 MiB; at most 4 may be partly received per socket. Senders interleave fragments by priority (control and replies, then durable upload, then ephemeral), in order within a class; there are no delivery credits.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "axo.transport.fragment"
        },
        "params": {
          "type": "object",
          "properties": {
            "messageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 364
            },
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 365
            },
            "data": {
              "type": "string",
              "maxLength": 61440,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "required": [
            "messageId",
            "index",
            "count",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "TransportDiscard": {
      "description": "Tells the receiver to drop a fragmented message it has partly received, because the sender gave up on it. The socket stays open; later fragments of the message are ignored.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "axo.transport.discard"
        },
        "params": {
          "type": "object",
          "properties": {
            "messageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          "required": [
            "messageId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "ListCall": {
      "description": "Lists the account's connections: every paired Mac as a host connection, and every third-party connection. Sent by axod on behalf of a Session; the account answers through the host's HostDO.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "type": "string",
          "const": "axo.connections.list"
        },
        "params": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "ListResult": {
      "description": "The result of axo.connections.list.",
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "host"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                  },
                  "hostId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "online",
                      "offline"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "hostId",
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "thirdParty"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "ready",
                      "needsSignIn",
                      "error"
                    ]
                  },
                  "tools": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "syncedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastError": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 512
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "url",
                  "state",
                  "tools",
                  "syncedAt",
                  "lastError"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "app"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^apps\\.[a-z][a-z0-9_]{0,31}$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "permissions": {
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "ready",
                      "needsSignIn"
                    ]
                  },
                  "accounts": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "account": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 320
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "needsSignIn"
                          ]
                        },
                        "lastError": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 512
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "account",
                        "state",
                        "lastError"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "tools": {
                    "maxItems": 256,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  },
                  "lastError": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 512
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "title",
                  "description",
                  "permissions",
                  "state",
                  "accounts",
                  "tools",
                  "lastError"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "connections"
      ],
      "additionalProperties": false
    },
    "SearchCall": {
      "description": "Runs a JavaScript function over `codemode.tools()`, the definitions of every reachable tool, and returns what it selects. Sent by axod on behalf of a Session; the account answers through the host's HostDO.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "type": "string",
          "const": "axo.connections.search"
        },
        "params": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "required": [
            "sessionId",
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "SearchResult": {
      "description": "The result of axo.connections.search.",
      "type": "object",
      "properties": {
        "result": {}
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "ExecuteCall": {
      "description": "Runs a JavaScript function in the account's Dynamic Worker with a `codemode` proxy whose methods call tools. Sent by axod on behalf of a Session; the account answers through the host's HostDO.",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "type": "string",
          "const": "axo.connections.execute"
        },
        "params": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "required": [
            "sessionId",
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "ExecuteResult": {
      "description": "The result of axo.connections.execute.",
      "type": "object",
      "properties": {
        "result": {},
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "result",
        "logs"
      ],
      "additionalProperties": false
    },
