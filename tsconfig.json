{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bridge/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"],
  "exclude": ["bridge/dist", "tests/fixtures/files-worker.ts"]
}
