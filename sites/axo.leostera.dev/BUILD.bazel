load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//sites/axo.leostera.dev:cf/package_json.bzl", cf_bin = "bin")
load("@npm//sites/axo.leostera.dev:vite/package_json.bzl", vite_bin = "bin")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

_CONFIG = [
    "cloudflare.config.ts",
    "package.json",
    "vite.config.ts",
]

_NODE_MODULES = [
    ":node_modules/@axo/api-worker",
    ":node_modules/@axo/apps",
    ":node_modules/@axo/protocol",
    ":node_modules/@axo/web-app",
    ":node_modules/@cloudflare/vite-plugin",
    ":node_modules/@vitejs/plugin-react",
    ":node_modules/cf",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/vite",
]

# The site's files, copied to the output tree by an untagged target (see node_test).
js_library(
    name = "app_files",
    srcs = _CONFIG + ["index.html"] + glob(["public/**", "src/**"]),
    deps = _NODE_MODULES,
)

# The Cloudflare CLI, run from the site so it uses the site's account (bazel run //:publish).
cf_bin.cf_binary(
    name = "cf",
    chdir = package_name(),
    data = [":app_files"],
)

# Deploy the Bazel-built site; `cf deploy` otherwise runs npx outside Bazel's dependency graph.
cf_bin.cf_binary(
    name = "deploy",
    args = ["deploy", "--prebuilt"],
    chdir = package_name(),
    data = [":app_files", ":site"],
)

# .cloudflare/types/index.d.ts: the Worker's Env and the Workers runtime (cloudflare:workers),
# generated from cloudflare.config.ts by `cf workers types`.
cf_bin.cf(
    name = "worker_types_d_ts",
    srcs = [":app_files"],
    outs = [".cloudflare/types/index.d.ts"],
    args = [
        "workers",
        "types",
        "--quiet",
    ],
    chdir = package_name(),
)

# The runtime's types without the Env inferred from cloudflare.config.ts, for @axo/api-worker's own
# typecheck: the Worker declares the bindings it uses, and this site's typecheck, which reads the
# Worker's source with the inferred Env, checks that the config provides them.
genrule(
    name = "worker_runtime_types_d_ts",
    srcs = [":worker_types_d_ts"],
    outs = [".cloudflare/types/runtime.d.ts"],
    cmd = "sed -n '/^\\/\\/ Begin runtime types/,$$p' $< > $@ && grep -q 'interface Request' $@",
)

js_library(
    name = "worker_runtime_types",
    srcs = [":worker_runtime_types_d_ts"],
)

# The types refer to cloudflare.config.ts, and it to the Worker's source, so those come as types:
# ts_project reads only the types of what it depends on, and without them Env is `any`.
js_library(
    name = "worker_types",
    srcs = [":worker_types_d_ts"],
    types = _CONFIG + glob(["src/**/*.ts"]),
    deps = [":app_files"],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = _NODE_MODULES + [
        ":worker_types",
        "//packages/axo-web-app:vite_env",
    ],
)

# .cloudflare/output: the Worker and the web app's assets, built by Vite with Cloudflare's plugin, as
# `cf build` does (it runs `npx vite build`).
vite_bin.vite(
    name = "site",
    srcs = [":app_files"],
    out_dirs = [".cloudflare/output"],
    args = ["build"],
    chdir = package_name(),
    # The sandbox's inputs are symlinks out of the output tree; Vite follows them out of its root.
    execution_requirements = {"no-sandbox": "1"},
)

# The whole site under `cf dev`: pages, assets and the account APIs failing closed.
node_test(
    name = "test",
    data = [
        ":app_files",
        ":site_test_files",
    ],
    tags = ["no-sandbox"],
    tests = glob(["tests/*.test.mjs"]),
    tests_in_data = True,
    # share-page.test.mjs imports the Worker's TypeScript, and through it @axo/protocol's.
    tsx = True,
)

js_library(
    name = "site_test_files",
    srcs = glob(["tests/*.test.mjs"]),
    deps = [":node_modules/tsx"],
)
