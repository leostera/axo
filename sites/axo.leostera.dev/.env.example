# Cloudflare Access application that guards /app and /api/* (RFD0013 gap plan, G1).
# The team domain is the JWT issuer; the audience is the application's AUD tag.
ACCESS_TEAM_DOMAIN=https://replace-with-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-aud-tag

# Keys pairing-code and host-credential verifiers. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
