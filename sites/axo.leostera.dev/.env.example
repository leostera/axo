# Cloudflare OAuth client for sign-in (RFD0013). Create it in the Cloudflare dashboard with the
# callback https://axo.leostera.dev/api/auth/cloudflare/callback and the user-details.read scope.
OAUTH_CLIENT_ID=replace-with-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Keys every secret the Worker derives or seals (session hashes, pairing codes, host credentials).
# Generate with: openssl rand -base64 32. Changing it signs everyone out and unlinks every Mac.
SESSION_SECRET=replace-with-at-least-32-random-bytes
