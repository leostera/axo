# Cloudflare OAuth client for sign-in (RFD0013). Create it in the Cloudflare dashboard with the
# callback https://axo.leostera.dev/api/auth/cloudflare/callback and the user-details.read scope.
OAUTH_CLIENT_ID=replace-with-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Key 0 of the keys every secret the Worker derives or seals is made with (RFD0076). Generate with:
# openssl rand -base64 32. Never change it in place: that signs everyone out and unlinks every Mac.
# Rotate with SECRET_KEYS instead.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional: the current key and the one being rotated out, e.g.
# {"current":{"id":1,"secret":"<32+ random bytes>"},"previous":{"id":0}}. Key 0 is SESSION_SECRET.
# SECRET_KEYS=
