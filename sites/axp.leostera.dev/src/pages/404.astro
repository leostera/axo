---
import Site from "../layouts/Site.astro";
---

<Site title="Not found · AXP" description="This page does not exist." current="">
  <main id="content" class="mx-auto max-w-6xl px-5 pt-24">
    <p class="font-mono text-sm text-kumo-subtle">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-[-0.02em] text-kumo-strong">There is no page at this address</h1>
    <p class="mt-4 max-w-[60ch] text-kumo-default">
      The link may be out of date. The <a class="text-kumo-link underline underline-offset-4" href="/">specification</a>
      is the place to start.
    </p>
  </main>
</Site>
