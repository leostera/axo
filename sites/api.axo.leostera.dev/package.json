{
  "name": "@axo/private-api-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "npm --prefix ../../packages/axo-api run build && cf build",
    "typecheck": "npm --prefix ../../packages/axo-api run build && cf workers types && npm --prefix ../../packages/axo-api-worker run typecheck && tsc --noEmit",
    "test": "npm --prefix ../../packages/axo-api run schema:check && cf workers types && npm --prefix ../../packages/axo-api-worker test",
    "test:properties": "npm --prefix ../../packages/axo-api-worker run test:properties",
    "test:axod": "npm --prefix ../../packages/axo-api-worker run test:axod",
    "test:relay": "npm --prefix ../../packages/axo-api-worker run test:relay",
    "smoke": "npm --prefix ../../packages/axo-api-worker run smoke --"
  },
  "dependencies": {
    "@axo/api-worker": "file:../../packages/axo-api-worker"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "cf": "1.0.0-beta.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "workerd": "1.20261009.1"
  }
}
