load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@axo_config//:defs.bzl", "AXO")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bazel/apple:defs.bzl", "build_report")

# The workspace's node_modules: every package in pnpm-lock.yaml (RFD0021).
npm_link_all_packages(name = "node_modules")

exports_files([
    ".bazelrc",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "config.json",
    "package.json",
    "tsconfig.base.json",
])

# Every package's tsconfig.json extends this one.
ts_config(
    name = "tsconfig_base",
    src = "tsconfig.base.json",
    visibility = ["//visibility:public"],
)

# bazel-bin/report.txt, printed whenever it changes: what each optional piece of the build did
# (signing, dist/Axo.app, the phone, the Xcode project) and why any fell back (RFD0021).
build_report(
    name = "report",
    # It reports on the Xcode project, which holds the tests.
    testonly = True,
    pieces = [
        "//apple/AxoMac:Axo",
        "//apple/AxoMac:dist",
        "//apple/AxoPhone:AxoPhone_ipa",
        "//apple/AxoPhone:install",
        "//apple:xcodeproj_install",
        "//bazel/rust:rust_project",
    ],
)

# bazel run //:publish uploads the signed Mac app to the CDN the install script fetches from. It is
# the one step outside bazel build: it changes what everyone installs (RFD0021).
sh_binary(
    name = "publish",
    srcs = ["//bazel/publish:publish.sh"],
    args = [
        "$(rootpath //apple/AxoMac:Axo)",
        "$(rootpath //apple/AxoMac:Axo_zip)",
        "$(rootpath //sites/axo.leostera.dev:cf)",
        AXO["apple"]["team"],
        AXO["publish"]["bucket"],
        AXO["publish"]["url"],
        "$(rootpath //bazel/publish:release.sh)",
    ],
    data = [
        "//apple/AxoMac:Axo",
        "//apple/AxoMac:Axo_zip",
        "//sites/axo.leostera.dev:cf",
        "//bazel/publish:release.sh",
    ],
)
