<Window x:Class="Axo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Axo" Width="1180" Height="820" MinWidth="860" MinHeight="580" Loaded="OnLoaded" Closing="OnClosing" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,24,18,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,28"><TextBlock Text="axo" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="YOUR LOCAL AGENT WORKSPACE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="WORKSPACES" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,10"/><ComboBox x:Name="WorkspacePicker" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnWorkspaceChanged" Margin="0,0,0,10" Padding="8"/><Button Content="+  Open folder" Click="OpenFolder" Margin="0,0,0,24" HorizontalAlignment="Stretch"/></StackPanel>
        <Grid Grid.Row="2" Margin="10,0,0,10"><TextBlock Text="SESSIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="NewSessionButton" Content="+  New" HorizontalAlignment="Right" Padding="10,6" Click="NewSession" Margin="0"/></Grid>
        <ListBox x:Name="SessionList" Grid.Row="3" SelectionChanged="OnSessionChanged" ItemsSource="{Binding Sessions}">
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Margin="10,18,0,0"><TextBlock x:Name="DaemonStatus" Text="Connecting to axod…" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Windows preview · Codex CLI" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,23">
        <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="SessionTitle" Text="A place to work with Codex" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="WorkspacePath" Text="Open a folder to start a session." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="430" HorizontalAlignment="Left"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="TerminalButton" Content="Terminal ↗" Click="OpenTerminal" IsEnabled="False"/><Button x:Name="MoreButton" Content="•••" Click="ShowSessionMenu" IsEnabled="False" Padding="12,8" Margin="0"/></StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" x:Name="ErrorBanner" Background="#46372C" Padding="20,12" Visibility="Collapsed"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFDBAD"/></Border>
      <Grid Grid.Row="2">
        <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24"><TextBlock Text="Your next idea starts here." FontSize="27" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Open a project folder, create a session, and give Codex something to work on." Foreground="{StaticResource MutedBrush}" FontSize="15" LineHeight="25" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,24"/><Button Content="Open a project folder" Click="OpenFolder" HorizontalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="#24201A"/></StackPanel>
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="32,24" Visibility="Collapsed"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#20232A" CornerRadius="8" Padding="20,16" Margin="0,0,0,14"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontFamily="Segoe UI" FontSize="14"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="3" x:Name="ApprovalPanel" Background="#30372D" Margin="24,8,24,0" Visibility="Collapsed">
        <TextBlock x:Name="ApprovalTitle" Text="Codex needs your input" FontWeight="SemiBold" Margin="16,14,16,8"/>
        <TextBox x:Name="ApprovalDetail" IsReadOnly="True" Background="Transparent" BorderThickness="0" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="4,0,4,8"/>
        <StackPanel x:Name="QuestionFields" Margin="16,0,16,8"/>
        <StackPanel Orientation="Horizontal" Margin="16,0,16,14"><Button x:Name="ApproveButton" Content="Allow once" Click="Approve" Background="{StaticResource AccentBrush}" Foreground="#24201A"/><Button x:Name="DeclineButton" Content="Decline" Click="Decline"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="4" Margin="28,14,28,20">
        <TextBlock x:Name="ActivityText" Text="Local sessions stay with your daemon." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,10" TextTrimming="CharacterEllipsis"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="#252932"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Composer" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="170" VerticalScrollBarVisibility="Auto" Padding="16" PreviewKeyDown="ComposerKeyDown" IsEnabled="False" AutomationProperties.Name="Message Codex"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8"><Button x:Name="StopButton" Content="Stop" Click="StopTurn" Visibility="Collapsed"/><Button x:Name="SendButton" Content="Send ↑" Click="Send" IsEnabled="False" Background="{StaticResource AccentBrush}" Foreground="#24201A" Margin="0"/></StackPanel></Grid></Border>
        <TextBlock Text="Enter to send · Shift+Enter for a new line · Codex uses its own sign-in" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,9,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
