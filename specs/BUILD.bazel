load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/js:defs.bzl", "node_test")

# Feynman needs Bun; this focused gate uses the installed owned-Mac runtime, never npx/npm.
sh_test(
    name = "push_test",
    srcs = ["check-spec.sh"],
    args = ["check-push.ts"],
    data = [
        "check-push.ts",
        "elicitations/push.ts",
        "elicitations/notification-actions.ts",
        "elicitations/notification-replies.ts",
        "elicitations/account-access.ts",
        "//:node_modules/@leostera/feynman",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

node_test(
    name = "linux_sudo_input",
    tests = ["linux-sudo-input.test.ts"],
    tsx = True,
    data = [
        "elicitations/linux-sudo-input.ts",
        "//:node_modules/@leostera/feynman",
        "//:node_modules/tsx",
    ],
    timeout = "short",
)

node_test(
    name = "recovery_test",
    tests = ["check-recovery.ts"],
    tsx = True,
    data = [
        "setup/restart-continuation.ts",
        "setup/pinned-sessions.ts",
        "//:node_modules/@leostera/feynman",
        "//:node_modules/tsx",
    ],
    timeout = "moderate",
)

# RFD0070: a script's actions go through the gate; every rule of the model is needed.
sh_test(
    name = "tools_ask_test",
    srcs = ["check-spec.sh"],
    args = ["check-tools-ask.ts"],
    data = [
        "check-tools-ask.ts",
        "elicitations/tools-ask.ts",
        "//:node_modules/@leostera/feynman",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)
