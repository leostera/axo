module(
    name = "axo",
    version = "0.1.0",
)

bazel_dep(name = "rules_apple", version = "5.3.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_swift", version = "4.2.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//apple/AxoRPC:Package.resolved",
    swift = "//apple/AxoRPC:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_jsonrpc")

ghostty_repository = use_repo_rule("//:ghostty_repository.bzl", "ghostty_repository")
ghostty_repository(name = "ghostty")
