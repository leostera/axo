module(
    name = "axo",
    version = "0.1.0",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_apple", version = "5.3.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_swift", version = "4.2.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Every external crate the Rust code uses, declared here instead of in Cargo manifests (RFD0021).
# crate_universe resolves them and pins the versions in bazel/rust/Cargo.lock, which it rewrites
# when a spec changes; no Cargo command is ever run by hand.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(package = "clap", version = "4.5", features = ["derive", "string"])
crate.spec(package = "core-foundation", version = "0.10.1")
crate.spec(package = "env_logger", version = "0.11")
crate.spec(package = "httparse", version = "1.10.1")
crate.spec(package = "jsonrpc-core", version = "18.0.0")
crate.spec(package = "libc", version = "0.2")
crate.spec(package = "log", version = "0.4")
crate.spec(package = "native-tls", version = "0.2.18")
crate.spec(package = "rusqlite", version = "0.39.0", features = ["bundled"])
crate.spec(package = "security-framework", version = "3.7.0")
crate.spec(package = "serde", version = "1", features = ["derive"])
crate.spec(package = "serde_json", version = "1")
crate.spec(package = "sha2", version = "0.10")
crate.spec(package = "shlex", version = "2.0.1")
crate.spec(package = "tokio", version = "1", features = ["io-util", "net", "rt-multi-thread", "sync", "time"])
crate.spec(package = "tungstenite", version = "0.30.0", features = ["native-tls", "url"])
crate.spec(package = "url", version = "2.5.8")
crate.from_specs(
    name = "crates",
    cargo_lockfile = "//bazel/rust:Cargo.lock",
)
use_repo(crate, "crates")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//apple:Package.resolved",
    swift = "//apple:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_fuzzymatch", "swiftpkg_rive_ios")

# config.json, config.local.json and what this Mac can do (RFD0021).
axo_config = use_extension("//bazel/config:extension.bzl", "axo_config")
use_repo(axo_config, "axo_config")

ghostty_repository = use_repo_rule("//:ghostty_repository.bzl", "ghostty_repository")
ghostty_repository(name = "ghostty")

ghostty_vt_repository = use_repo_rule("//:ghostty_vt_repository.bzl", "ghostty_vt_repository")
ghostty_vt_repository(name = "ghostty_vt")

# JavaScript and TypeScript: one pnpm workspace (pnpm-workspace.yaml, pnpm-lock.yaml), built and
# tested by aspect_rules_js and aspect_rules_ts (RFD0021).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "7.0.2")
use_repo(typescript, "npm_typescript")
