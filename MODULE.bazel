module(
    name = "axo",
    version = "0.1.0",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_apple", version = "5.3.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_swift", version = "4.2.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.0"],
    # Keep the formatter's rustc_driver DLL compatible on Windows.
    rustfmt_version = "1.99.0",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Every external crate the Rust code uses, declared here instead of in Cargo manifests (RFD0021).
# crate_universe resolves them and pins the versions in bazel/rust/Cargo.lock, which it rewrites
# when a spec changes; no Cargo command is ever run by hand.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(package = "clap", version = "4.5", features = ["derive", "string"])
crate.spec(package = "core-foundation", version = "0.10.1")
crate.spec(package = "env_logger", version = "0.11")
crate.spec(package = "futures-util", version = "0.3", default_features = False, features = ["sink", "std"])
# Input sealed to this Mac (RFD0029): HPKE, DHKEM(P-256, HKDF-SHA256), HKDF-SHA256, AES-256-GCM.
crate.spec(package = "hpke", version = "0.13", default_features = False, features = ["alloc", "p256"])
crate.spec(package = "httparse", version = "1.10.1")
crate.spec(package = "jsonrpc-core", version = "18.0.0")
crate.spec(package = "libc", version = "0.2")
crate.spec(package = "log", version = "0.4")
crate.spec(package = "native-tls", version = "0.2.18")
# Answers signed by the person's devices (RFD0029): ECDSA P-256 over SHA-256.
crate.spec(package = "p256", version = "0.13", features = ["ecdsa"])
crate.spec(package = "rand_core", version = "0.9", features = ["os_rng"])
crate.spec(package = "rusqlite", version = "0.39.0", features = ["bundled"])
crate.spec(package = "security-framework", version = "3.7.0")
crate.spec(package = "serde", version = "1", features = ["derive"])
crate.spec(package = "serde_json", version = "1")
crate.spec(package = "sha2", version = "0.10")
crate.spec(package = "shlex", version = "2.0.1")
crate.spec(package = "tokio", version = "1", features = ["io-util", "macros", "net", "process", "rt-multi-thread", "signal", "sync", "time"])
crate.spec(package = "tokio-tungstenite", version = "0.30.0", features = ["native-tls", "url"])
crate.spec(package = "tungstenite", version = "0.30.0", features = ["native-tls", "url"])
crate.spec(package = "url", version = "2.5.8")
crate.spec(package = "zeroize", version = "1")
crate.spec(package = "windows-sys", version = "0.61", features = [
    "Win32_Foundation",
    "Win32_Security",
    "Win32_Security_Authorization",
    "Win32_System_Threading",
    "Win32_System_JobObjects",
])
# Cua Driver (MIT), pinned: only its native platform runtime and core are linked into axod;
# its daemon, MCP server, SDK bindings and telemetry are not.
crate.spec(package = "platform-macos", git = "https://github.com/trycua/cua", rev = "2b7bd1b9046b63079f684810e8729a84f967a128")
crate.spec(package = "platform-windows", git = "https://github.com/trycua/cua", rev = "2b7bd1b9046b63079f684810e8729a84f967a128")
crate.spec(package = "cua-driver-core", git = "https://github.com/trycua/cua", rev = "2b7bd1b9046b63079f684810e8729a84f967a128")
crate.spec(package = "cursor-overlay", git = "https://github.com/trycua/cua", rev = "2b7bd1b9046b63079f684810e8729a84f967a128")

# cua-driver-core embeds its guides from outside its crate folder, which crate_universe does not
# fetch; this patch carries them into the crate (regenerate it on every Cua bump).
crate.annotation(
    crate = "cua-driver-core",
    patch_args = ["-p1"],
    patches = ["//third_party/cua:cua-driver-core-skills.patch"],
    repositories = ["crates"],
)
crate.from_specs(
    name = "crates",
    cargo_lockfile = "//bazel/rust:Cargo.lock",
)
use_repo(crate, "crates")

# Windows Cua's Rego dependency links the Spectre-mitigated CRT. Fetch the
# matching Microsoft libraries as a build input, rather than requiring another
# elevated Visual Studio installation. The package is not shipped with Axo.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "axo_msvc_spectre_x64",
    urls = ["https://download.visualstudio.microsoft.com/download/pr/67cf767c-5e71-47c2-a54a-cd5631e28942/6d7cb93cc7fdc206f44999850b414600ae1041d0db7d2fe9d0ff658abfb97b58/Microsoft.VC.14.44.17.14.CRT.x64.Desktop.spectre.base.vsix"],
    sha256 = "6d7cb93cc7fdc206f44999850b414600ae1041d0db7d2fe9d0ff658abfb97b58",
    type = "zip",
    strip_prefix = "Contents/VC/Tools/MSVC/14.44.35207/lib/spectre/x64",
    build_file_content = 'filegroup(name = "libraries", srcs = glob(["*.lib", "*.obj"]), visibility = ["//visibility:public"])\nexports_files(["vcruntime.lib"])',
)
crate.annotation(
    crate = "msvc_spectre_libs",
    patch_args = ["-p1"],
    patches = ["//third_party/cua:msvc-spectre-path.patch"],
    label_injections = {"@axo_msvc_spectre_x64": "@axo_msvc_spectre_x64"},
    repositories = ["crates"],
)
crate.annotation_select(
    crate = "msvc_spectre_libs",
    triples = ["x86_64-pc-windows-msvc"],
    build_script_data = ["@axo_msvc_spectre_x64//:libraries", "@axo_msvc_spectre_x64//:vcruntime.lib"],
    build_script_env = {"AXO_SPECTRE_LIBRARY": "$(execpath @axo_msvc_spectre_x64//:vcruntime.lib)"},
    repositories = ["crates"],
)
crate.annotation(
    crate = "windows_x86_64_msvc",
    patches = ["//third_party/cua:windows-import-libraries.patch"],
    patch_args = ["-p1"],
    repositories = ["crates"],
)

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//apple:Package.resolved",
    swift = "//apple:Package.swift",
)
use_repo(swift_deps, "swift_package", "swiftpkg_fuzzymatch", "swiftpkg_rive_ios")

# config.json, config.local.json and what this Mac can do (RFD0021).
axo_config = use_extension("//bazel/config:extension.bzl", "axo_config")
use_repo(axo_config, "axo_config", "axo_files")

# The local decision side-car, llama.cpp's llama-server, pinned (see the file).
llama_server_repository = use_repo_rule("//third_party/llama.cpp:repository.bzl", "llama_server_repository")
llama_server_repository(name = "llama_server")

ghostty_repository = use_repo_rule("//:ghostty_repository.bzl", "ghostty_repository")
ghostty_repository(name = "ghostty")

ghostty_vt_repository = use_repo_rule("//:ghostty_vt_repository.bzl", "ghostty_vt_repository")
ghostty_vt_repository(name = "ghostty_vt")

# JavaScript and TypeScript: one pnpm workspace (pnpm-workspace.yaml, pnpm-lock.yaml), built and
# tested by aspect_rules_js and aspect_rules_ts (RFD0021).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "7.0.2")
use_repo(typescript, "npm_typescript")
