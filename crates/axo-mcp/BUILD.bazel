load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# The MCP server for one Session's agent (RFD0015). It runs inside axod on the connection
# `axod mcp` opens, and calls axod's methods in process as that connection's peer; it knows
# nothing of the server's insides (RFD0034).
rust_library(
    name = "axo_mcp",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    # AXO_BUILD_NUMBER: axod's build number from config.json (RFD0021).
    rustc_env_files = ["@axo_config//:axod.env"],
    deps = [
        "//crates/axo-computer:axo_computer",
        "//crates/axo-ipc:axo_ipc",
        "//crates/axo-protocol:axo_protocol",
        "@crates//:log",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "axo_mcp_tests",
    crate = ":axo_mcp",
    edition = "2024",
    deps = ["@crates//:tokio"],
)
