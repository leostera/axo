load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "axo_pty",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    deps = [
        "//crates/axo-vt:axo_vt",
        "@crates//:shlex",
        "@crates//:libc",
        "@crates//:log",
    ],
)

rust_test(
    name = "axo_pty_tests",
    crate = ":axo_pty",
    edition = "2024",
)
