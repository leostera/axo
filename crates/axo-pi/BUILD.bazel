load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "axo_pi",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    deps = [
        "//crates/axo-protocol:axo_protocol",
        "//crates/axo-pty:axo_pty",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "axo_pi_tests",
    crate = ":axo_pi",
    edition = "2024",
)
