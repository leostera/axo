load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "axo_protocol",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "axo_protocol_tests",
    compile_data = ["//schemas/axo.leostera.dev/v1"],
    crate = ":axo_protocol",
    edition = "2024",
)
