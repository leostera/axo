load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "axo_store",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    deps = [
        "//crates/axo-pi:axo_pi",
        "//crates/axo-protocol:axo_protocol",
        "@crates//:log",
        "@crates//:rusqlite",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "axo_store_tests",
    crate = ":axo_store",
    edition = "2024",
)
