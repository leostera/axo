load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Links libghostty-vt from the pinned Ghostty build.
rust_library(
    name = "axo_vt",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    link_deps = ["@ghostty_vt"],
)

rust_test(
    name = "axo_vt_tests",
    crate = ":axo_vt",
    edition = "2024",
)
