load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@axo_config//:defs.bzl", "AXO")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "pi_extension_fixture",
    srcs = ["testdata/pi-extension.js"],
    testonly = True,
)

# The same extension for the Worker's relay tests, which read it from the output tree.
js_library(
    name = "pi_extension_fixture_js",
    testonly = True,
    srcs = ["testdata/pi-extension.js"],
)

rust_library(
    name = "axo_server",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    # AXO_BUILD_NUMBER: axod's build number from config.json (RFD0021).
    rustc_env_files = ["@axo_config//:axod.env"],
    # Cargo versions are full semver: major.minor.0 from config.json's major.minor.
    version = AXO["version"] + ".0",
    deps = [
        "//crates/axo-apps:axo_apps",
        "//crates/axo-assets:axo_assets",
        "//crates/axo-computer-use:axo_computer_use",
        "//crates/axo-questions:axo_questions",
        "//crates/axo-computer:axo_computer",
        "//crates/axo-ipc:axo_ipc",
        "//crates/axo-mcp:axo_mcp",
        "//crates/axo-agent:axo_agent",
        "//crates/axo-protocol:axo_protocol",
        "//crates/axo-pty:axo_pty",
        "//crates/axo-relay:axo_relay",
        "//crates/axo-seal:axo_seal",
        "//crates/axo-store:axo_store",
        "@crates//:jsonrpc-core",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tokio-rusqlite",
        "@crates//:notify",
        "@crates//:shlex",
        "@crates//:zeroize",
        "@crates//:core-foundation",
        "//crates/axod-infer:axod_infer",
    ],
)

rust_test(
    name = "axo_server_tests",
    srcs = glob(["src/**/*.rs"]),
    data = [":pi_extension_fixture", "//crates/axod:fake_pi"],
    env = {
        "AXO_PI_EXTENSION_PATH": "$(rootpath :pi_extension_fixture)",
        "AXO_TEST_FAKE_PI": "$(rootpath //crates/axod:fake_pi)",
    },
    edition = "2024",
    # AXO_BUILD_NUMBER: axod's build number from config.json (RFD0021).
    rustc_env_files = ["@axo_config//:axod.env"],
    # Cargo versions are full semver: major.minor.0 from config.json's major.minor.
    version = AXO["version"] + ".0",
    deps = [
        "//crates/axo-apps:axo_apps",
        "//crates/axo-assets:axo_assets",
        "//crates/axo-computer-use:axo_computer_use",
        "//crates/axo-questions:axo_questions",
        "//crates/axo-computer:axo_computer",
        "//crates/axo-ipc:axo_ipc",
        "//crates/axo-mcp:axo_mcp",
        "//crates/axo-agent:axo_agent",
        "//crates/axo-protocol:axo_protocol",
        "//crates/axo-pty:axo_pty",
        "//crates/axo-relay:axo_relay",
        "//crates/axo-seal:axo_seal",
        "//crates/axo-store:axo_store",
        "@crates//:jsonrpc-core",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:p256",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tokio-rusqlite",
        "@crates//:notify",
        "@crates//:shlex",
        "@crates//:zeroize",
        "@crates//:core-foundation",
        "@crates//:rusqlite",
        "//crates/axod-infer:axod_infer",
    ],
)
