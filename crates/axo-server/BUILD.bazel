load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@axo_config//:defs.bzl", "AXO")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "pi_extension_fixture",
    srcs = ["testdata/pi-extension.js"],
    testonly = True,
)

# The same extension for the Worker's relay tests, which read it from the output tree.
js_library(
    name = "pi_extension_fixture_js",
    testonly = True,
    srcs = ["testdata/pi-extension.js"],
)

rust_library(
    name = "axo_server",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    # AXO_BUILD_NUMBER: axod's build number from config.json (RFD0021).
    rustc_env_files = ["@axo_config//:axod.env"],
    version = AXO["version"],
    deps = [
        "//crates/axo-ipc:axo_ipc",
        "//crates/axo-panes:axo_panes",
        "//crates/axo-pi:axo_pi",
        "//crates/axo-protocol:axo_protocol",
        "//crates/axo-pty:axo_pty",
        "//crates/axo-relay:axo_relay",
        "//crates/axo-store:axo_store",
        "@crates//:jsonrpc-core",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:shlex",
        "@crates//:core-foundation",
    ],
)

rust_test(
    name = "axo_server_tests",
    srcs = glob(["src/**/*.rs"]),
    data = [":pi_extension_fixture"],
    env = {"AXO_PI_EXTENSION_PATH": "$(rootpath :pi_extension_fixture)"},
    edition = "2024",
    # AXO_BUILD_NUMBER: axod's build number from config.json (RFD0021).
    rustc_env_files = ["@axo_config//:axod.env"],
    version = AXO["version"],
    deps = [
        "//crates/axo-ipc:axo_ipc",
        "//crates/axo-panes:axo_panes",
        "//crates/axo-pi:axo_pi",
        "//crates/axo-protocol:axo_protocol",
        "//crates/axo-pty:axo_pty",
        "//crates/axo-relay:axo_relay",
        "//crates/axo-store:axo_store",
        "@crates//:jsonrpc-core",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:shlex",
        "@crates//:core-foundation",
        "@crates//:rusqlite",
    ],
)
