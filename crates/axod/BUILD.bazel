load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@axo_config//:defs.bzl", "AXO")

package(default_visibility = ["//visibility:public"])

exports_files(["testdata/pi-fixture.sh"])

rust_binary(
    name = "axod",
    srcs = ["src/main.rs"],
    edition = "2024",
    # The macOS the Mac app requires, so axod's minimum matches the app's (RFD0021).
    rustc_env = {"MACOSX_DEPLOYMENT_TARGET": AXO["apple"]["macos_min"]},
    # Cargo versions are full semver: major.minor.0 from config.json's major.minor.
    version = AXO["version"] + ".0",
    deps = [
        "//crates/axo-pty:axo_pty",
        "//crates/axo-server:axo_server",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:libc",
        "@crates//:log",
    ],
)

rust_test(
    name = "rpc_tests",
    srcs = ["tests/rpc.rs"],
    edition = "2024",
    data = [":axod", "//crates/axo-server:pi_extension_fixture", "testdata/pi-fixture.sh"],
    env = {
        "AXOD_BINARY": "$(rootpath :axod)",
        "AXO_PI_EXTENSION_PATH": "$(rootpath //crates/axo-server:pi_extension_fixture)",
        "AXO_TEST_PI_EXECUTABLE": "$(rootpath testdata/pi-fixture.sh)",
    },
    timeout = "short",
    deps = [
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:serde_json",
    ],
)

# The Pi stand-in for the Worker's relay tests, which read it from the output tree.
js_library(
    name = "pi_fixture_js",
    testonly = True,
    srcs = ["testdata/pi-fixture.sh"],
)

# The conformance suite (tests/conformance, harness in tests/support): the real axod binary,
# driven only over its socket, one target per area so they run side by side. See
# tests/conformance/inventory.rs for the rule that every method has a test here.
rust_binary(
    name = "fake_pi",
    testonly = True,
    srcs = ["testdata/fake_pi.rs"],
    edition = "2024",
    deps = [
        "@crates//:libc",
        "@crates//:serde_json",
    ],
)

CONFORMANCE = [
    "daemon",
    "sessions",
    "account",
    "elicitations",
    "mcp",
]

[
    rust_test(
        name = "conformance_" + area,
        srcs = ["tests/conformance/%s.rs" % area] + glob(["tests/support/*.rs"]),
        crate_root = "tests/conformance/%s.rs" % area,
        edition = "2024",
        data = [
            ":axod",
            ":fake_pi",
            "testdata/pi-fixture.sh",
            "//crates/axo-server:pi_extension_fixture",
        ],
        env = {
            "AXOD_BINARY": "$(rootpath :axod)",
            "AXO_TEST_FAKE_PI": "$(rootpath :fake_pi)",
            "AXO_TEST_PI_EXECUTABLE": "$(rootpath testdata/pi-fixture.sh)",
            "AXO_PI_EXTENSION_PATH": "$(rootpath //crates/axo-server:pi_extension_fixture)",
        },
        deps = [
            "@crates//:libc",
            "@crates//:serde_json",
        ],
    )
    for area in CONFORMANCE
]

rust_test(
    name = "conformance_inventory",
    srcs = ["tests/conformance/inventory.rs"],
    crate_root = "tests/conformance/inventory.rs",
    edition = "2024",
    data = glob(["tests/conformance/*.rs"]) + ["tests/rpc.rs"],
    env = {"CONFORMANCE_SOURCES": "$(rootpath tests/conformance/inventory.rs)"},
    deps = ["//crates/axo-protocol:axo_protocol"],
)
