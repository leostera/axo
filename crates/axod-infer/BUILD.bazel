load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# axod's local inference side-car and its client; Clef decisions first.
rust_library(
    name = "axod_infer",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    compile_data = ["@llama_server//:capabilities.json"],
    rustc_env = {"AXO_INFER_CAPABILITIES": "$(execpath @llama_server//:capabilities.json)"},
    deps = [
        "//crates/axo-protocol:axo_protocol",
        "//crates/axo-pty:axo_pty",
        "@crates//:libc",
        "@crates//:notify",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "axod_infer_tests",
    crate = ":axod_infer",
    edition = "2024",
)
