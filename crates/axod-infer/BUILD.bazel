load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# axod's local inference side-car and its client; Clef decisions first.
rust_library(
    name = "axod_infer",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "//crates/axo-pty:axo_pty",
        "@crates//:libc",
        "@crates//:notify",
        "@crates//:log",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "axod_infer_tests",
    crate = ":axod_infer",
    edition = "2024",
)
