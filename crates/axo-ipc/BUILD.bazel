load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "axo_ipc",
    srcs = glob(["src/*.rs"]),
    edition = "2024",
    deps = [
        "@crates//:jsonrpc-core",
        "@crates//:log",
    ] + select({
        "@platforms//os:macos": [
            "@crates//:core-foundation",
            "@crates//:libc",
            "@crates//:security-framework",
        ],
        "//conditions:default": [],
    }) + [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "axo_ipc_tests",
    crate = ":axo_ipc",
    edition = "2024",
)
