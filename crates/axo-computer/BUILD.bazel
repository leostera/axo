load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Native computer use through the pinned Cua runtime, embedded in axod.
rust_library(
    name = "axo_computer",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "//crates/axo-protocol:axo_protocol",
        "@crates//:log",
        "@crates//:serde_json",
    ] + select({
        "@platforms//os:macos": [
            "//crates/axod-infer:axod_infer",
            "@crates//:core-foundation",
            "@crates//:cua-driver-core",
            "@crates//:cursor-overlay",
            "@crates//:platform-macos",
            "@crates//:tokio",
        ],
        "@platforms//os:windows": [
            "@crates//:windows",
            "@crates//:cua-driver-core",
            "@crates//:cursor-overlay",
            "@crates//:platform-windows",
            "@crates//:tokio",
        ],
        "//conditions:default": ["//crates/axod-infer:axod_infer"],
    }),
)

rust_test(
    name = "axo_computer_tests",
    crate = ":axo_computer",
    edition = "2024",
)
