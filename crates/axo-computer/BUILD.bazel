load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Computer use on the Mac axod runs on, through Cua Driver's macOS runtime, embedded in-process
# so its Accessibility and Screen Recording checks use Axo's grants. Empty elsewhere.
rust_library(
    name = "axo_computer",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = ["@crates//:serde_json"] + select({
        "@platforms//os:macos": [
            "@crates//:core-foundation",
            "@crates//:cua-driver-core",
            "@crates//:cursor-overlay",
            "@crates//:platform-macos",
            "@crates//:tokio",
        ],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "axo_computer_tests",
    crate = ":axo_computer",
    edition = "2024",
)
