load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "install_phone_app.sh",
    "install_xcodeproj.sh",
    "package_test.sh",
    "sign_mac_app.sh",
    "strip_mac_app.sh",
])

