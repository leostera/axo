load("@rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "install_phone_app.sh",
    "install_xcodeproj.sh",
    "package_test.sh",
    "sign_mac_app.sh",
    "strip_mac_app.sh",
    "distribution_preflight.py",
    "distribution_preflight.sh",
    "preservation_probe.bzl",
    "preservation_probe_info.py",
])

sh_test(
    name = "strip_mac_app_test",
    srcs = ["strip_mac_app_test.sh"],
    args = ["$(rootpath :strip_mac_app.sh)"],
    data = [":strip_mac_app.sh"],
    tags = ["no-sandbox"],
    target_compatible_with = ["@platforms//os:macos"],
)

# Inspection only: no provisioning, signing, notarization, installation or upload effects.
sh_binary(
    name = "distribution_preflight",
    srcs = ["distribution_preflight.sh"],
    args = ["$(rootpath :distribution_preflight.py)", "$(rootpath //:config.json)"],
    data = ["distribution_preflight.py", "//:config.json"],
    target_compatible_with = ["@platforms//os:macos"],
)

sh_test(
    name = "preservation_probe_info_test",
    srcs = ["distribution_preflight_test.sh"],
    args = ["$(rootpath :preservation_probe_info_test.py)", "$(rootpath :preservation_probe_info.py)"],
    data = ["preservation_probe_info.py", "preservation_probe_info_test.py"],
    target_compatible_with = ["@platforms//os:macos"],
)

sh_test(
    name = "distribution_preflight_test",
    srcs = ["distribution_preflight_test.sh"],
    args = ["$(rootpath :distribution_preflight_test.py)", "$(rootpath :distribution_preflight.py)"],
    data = ["distribution_preflight.py", "distribution_preflight_test.py"],
    target_compatible_with = ["@platforms//os:macos"],
)

swift_binary(
    name = "install_app",
    srcs = ["install_app/main.swift"],
)
