load("@axo_config//:defs.bzl", "AXO")
load(":apple_signing_policy_test.bzl", "apple_signing_policy_test")
load(":identity_migration.bzl", "identity_preservation_probe_flag")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["extension.bzl", "apple_signing_policy.bzl", "identity_migration.bzl"])

identity_preservation_probe_flag(
    name = "identity_preservation_probe",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

identity_preservation_probe_flag(
    name = "identity_mobile_transfer",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "identity_mobile_transfer_enabled",
    flag_values = {":identity_mobile_transfer": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "identity_preservation_probe_enabled",
    flag_values = {":identity_preservation_probe": "true"},
    visibility = ["//visibility:public"],
)

apple_signing_policy_test(name = "apple_signing_policy_test")

sh_test(
    name = "apple_identity_test",
    srcs = ["apple_identity_test.sh"],
    args = [
        "$(rootpath //:config.json)",
        "$(rootpath //apple/AxoMobile:AxoMobile.entitlements)",
        "$(rootpath //apple/AxoMobile:AxoMobile-device.entitlements)",
        "$(rootpath //apple/AxoWatch:companion_info)",
        "$(rootpath //apple/AxoWatch:AxoWatch.entitlements)",
        "$(rootpath //apple/AxoWatchComplication:AxoWatchComplication.entitlements)",
    ],
    data = [
        "//:config.json",
        "//apple/AxoMobile:AxoMobile.entitlements",
        "//apple/AxoMobile:AxoMobile-device.entitlements",
        "//apple/AxoWatch:companion_info",
        "//apple/AxoWatch:AxoWatch.entitlements",
        "//apple/AxoWatchComplication:AxoWatchComplication.entitlements",
    ],
)

# The application label resolves as its launch script in location expansion; select its files.
filegroup(
    name = "phone_identity_archive",
    testonly = True,
    srcs = ["//apple/AxoMobile:AxoMobileApp"],
)

sh_test(
    name = "apple_bundle_identity_test",
    srcs = ["apple_bundle_identity_test.sh"],
    args = ["$(rootpath //:config.json)", "$(rootpath :phone_identity_archive)"],
    data = ["//:config.json", ":phone_identity_archive"],
    tags = ["manual"],
)

sh_test(
    name = "macos_minimum_os_test",
    srcs = ["macos_minimum_os_test.sh"],
    args = [
        AXO["apple"]["macos_min"],
        "$(rootpath //:.bazelrc)",
    ],
    data = ["//:.bazelrc"],
)
