package(default_visibility = ["//visibility:public"])

# Explicit targets for dependency-graph checks. These do not imply that every Axo client
# can build on these platforms; native inference bindings must not leak Apple dependencies.
platform(
    name = "linux_x86_64",
    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

platform(
    name = "windows_x86_64",
    constraint_values = ["@platforms//os:windows", "@platforms//cpu:x86_64"],
)

platform(
    name = "macos_x86_64",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:x86_64"],
)
