common --enable_bzlmod
build --enable_platform_specific_config
build --macos_minimum_os=14.0
test --test_output=errors
common --repo_env=DO_NOT_TRACK=1
# TypeScript 7 (tsc) writes the JavaScript, as it did before Bazel.
common --@aspect_rules_ts//ts:default_to_tsc_transpiler

# Cua's capture crates (axo-computer) compile Swift bridges with `swift build` in their build
# scripts, which cannot run inside Bazel's macOS sandbox (nested sandbox-exec).
build --strategy_regexp="^Running Cargo build script (apple-[a-z]+|screencapturekit)"=local
