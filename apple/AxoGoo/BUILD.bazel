load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# The goo Axo stretches out of the menu bar on: a LiquidFun fluid behind a small C interface,
# which Swift imports as `AxoGoo`.
cc_library(
    name = "AxoGoo",
    srcs = ["src/axo_goo.cpp"],
    hdrs = ["include/axo_goo.h"],
    aspect_hints = [":module"],
    copts = ["-O2", "-std=c++17"],
    strip_include_prefix = "include",
    deps = ["//third_party/liquidfun"],
)

swift_interop_hint(
    name = "module",
    module_name = "AxoGoo",
)

swift_test(
    name = "AxoGooTests",
    srcs = ["Tests/AxoGooTests.swift"],
    deps = [":AxoGoo"],
)
