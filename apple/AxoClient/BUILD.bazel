load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# Swift client for Axo hosts: a pluggable transport (Unix socket to the local axod now; the
# account relay next), JSON-RPC over one persistent connection, axod's typed API, and pane
# attachment. No UI, so every Apple client shares it.
swift_library(
    name = "AxoClient",
    module_name = "AxoClient",
    srcs = glob(["Sources/AxoClient/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = ["//apple/AxoProtocol"],
)

swift_test(
    name = "AxoClientDaemonInteropTests",
    srcs = glob(["Tests/AxoClientDaemonInteropTests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    data = [
        "//crates/axo-server:pi_extension_fixture",
        "//crates/axod:axod",
        "//crates/axod:testdata/pi-fixture.sh",
    ],
    env = {
        "AXOD_BINARY": "$(rootpath //crates/axod:axod)",
        "AXO_PI_EXTENSION_PATH": "$(rootpath //crates/axo-server:pi_extension_fixture)",
        "AXO_TEST_PI_EXECUTABLE": "$(rootpath //crates/axod:testdata/pi-fixture.sh)",
    },
    tags = ["no-sandbox"],
    timeout = "short",
    deps = [
        ":AxoClient",
        "//apple/AxoProtocol",
    ],
)

swift_test(
    name = "AxoClientTests",
    srcs = glob(["Tests/AxoClientTests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        ":AxoClient",
        "//apple/AxoProtocol",
    ],
)
