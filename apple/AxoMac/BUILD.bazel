load("@rules_apple//apple:macos.bzl", "macos_application", "macos_ui_test")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcodeproj")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Info.plist",
    "AxoUITest-Info.plist",
    "Resources/dev.leostera.axo.axod.plist",
])

AXO_MAC_DEPS = [
    "//apple/AxoDaemonManager:AxoDaemonManager",
    "//apple/AxoRPC:AxoRPC",
    "@ghostty//:GhosttyKit",
]

# The shipped app. Fixture entrypoints in Sources/AxoMac/TestHost are never compiled in.
swift_library(
    name = "AxoMac",
    module_name = "AxoMac",
    srcs = glob(
        ["Sources/AxoMac/**/*.swift"],
        exclude = ["Sources/AxoMac/TestHost/**"],
    ),
    copts = ["-swift-version", "5"],
    deps = AXO_MAC_DEPS,
)

# The same app plus self-test and UI-automation launch modes, for AxoUITestApp only.
swift_library(
    name = "AxoMacTestHost",
    # A distinct module name keeps outputs separate; nothing imports this module.
    module_name = "AxoMacTestHost",
    srcs = glob(["Sources/AxoMac/**/*.swift"]),
    copts = ["-swift-version", "5"],
    defines = ["AXO_TEST_HOST"],
    deps = AXO_MAC_DEPS,
)

swift_test(
    name = "AxoMacTests",
    srcs = glob(
        ["Tests/AxoMacTests/*.swift"],
        # These need a live daemon, packaged app or UI runner; see their own targets.
        exclude = [
            "Tests/AxoMacTests/TerminalAppE2ETests.swift",
            "Tests/AxoMacTests/TerminalWorkbenchE2ETests.swift",
        ],
    ),
    copts = ["-swift-version", "5"],
    deps = [":AxoMac"],
)

swift_test(
    name = "TerminalWorkbenchE2ETests",
    srcs = ["Tests/AxoMacTests/TerminalWorkbenchE2ETests.swift"],
    copts = ["-swift-version", "5"],
    data = [
        "//crates/axo-server:pi_extension_fixture",
        "//crates/axod:axod",
        "//crates/axod:testdata/pi-fixture.sh",
    ],
    env = {
        "AXOD_TEST_BINARY": "$(rootpath //crates/axod:axod)",
        "AXO_PI_EXTENSION_PATH": "$(rootpath //crates/axo-server:pi_extension_fixture)",
        "AXO_TEST_PI_EXECUTABLE": "$(rootpath //crates/axod:testdata/pi-fixture.sh)",
    },
    deps = [":AxoMac"],
    tags = ["no-sandbox"],
    timeout = "short",
)

swift_library(
    name = "AxoVisualUITestsLib",
    testonly = True,
    srcs = glob(["Tests/AxoVisualUITests/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [":AxoMac"],
)

macos_ui_test(
    name = "AxoVisualUITests",
    bundle_id = "dev.leostera.axo.vt",
    minimum_os_version = "14.0",
    test_host = ":AxoUITestApp",
    resources = ["//crates/axod:axod"],
    deps = [":AxoVisualUITestsLib"],
    tags = ["manual", "no-sandbox"],
    timeout = "long",
)

sh_test(
    name = "AxoVisualUITestsBazel",
    srcs = ["run_visual_ui_test.sh"],
    data = [":xcodeproj", "//:MODULE.bazel", "//crates/axod:axod"],
    env = {
        "AXO_UI_AXOD_RUNFILE": "$(rlocationpath //crates/axod:axod)",
        "AXO_XCODEPROJ_RUNNER": "$(rlocationpath :xcodeproj)",
        "AXO_WORKSPACE_MODULE": "$(rlocationpath //:MODULE.bazel)",
    },
    env_inherit = [
        "AXO_UI_TEST_ONLY",
        "BAZEL_REAL",
        "BAZELISK_SKIP_WRAPPER",
        "DEVELOPER_DIR",
        "HOME",
        "PATH",
        "TMPDIR",
    ],
    tags = ["no-sandbox", "requires-mac-ui"],
    timeout = "long",
    target_compatible_with = ["@platforms//os:macos"],
)

swift_test(
    name = "AxoAppSelfTestTests",
    srcs = ["Tests/AxoMacTests/TerminalAppE2ETests.swift"],
    copts = ["-swift-version", "5"],
    data = [":AxoUITestApp"],
    env = {
        "AXO_APP_BUNDLE_ZIP": "$(rootpath :AxoUITestApp)",
    },
    tags = ["no-sandbox"],
    timeout = "short",
)

apple_bundle_version(
    name = "build_version",
    build_label_pattern = "axo_build_{build}",
    build_version = "{build}",
    capture_groups = {"build": "[0-9]+"},
    fallback_build_label = "axo_build_3",
    short_version_string = "0.1.0",
)

genrule(
    name = "launch_agent_plist",
    srcs = ["Resources/dev.leostera.axo.axod.plist"],
    outs = ["dev.leostera.axo.axod.plist"],
    cmd = "cp $(location Resources/dev.leostera.axo.axod.plist) $@",
)

macos_application(
    name = "AxoApp",
    bundle_id = "dev.leostera.axo",
    bundle_name = "Axo",
    executable_name = "Axo",
    infoplists = ["Info.plist"],
    minimum_os_version = "14.0",
    version = ":build_version",
    additional_contents = {
        ":launch_agent_plist": "Library/LaunchAgents",
        "//crates/axod:axod": "Helpers",
        "@ghostty//:resources": "Resources",
        "@ghostty//:terminfo": "Resources",
    },
    deps = [":AxoMac"],
)

macos_application(
    name = "AxoUITestApp",
    bundle_id = "dev.leostera.axo.ui-tests",
    bundle_name = "Axo",
    executable_name = "Axo",
    infoplists = ["AxoUITest-Info.plist"],
    minimum_os_version = "14.0",
    version = ":build_version",
    additional_contents = {
        ":launch_agent_plist": "Library/LaunchAgents",
        "//crates/axod:axod": "Helpers",
        "@ghostty//:resources": "Resources",
        "@ghostty//:terminfo": "Resources",
    },
    deps = [":AxoMacTestHost"],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "AxoMac",
    tags = ["manual"],
    top_level_targets = [
        ":AxoApp",
        ":AxoUITestApp",
        "//apple/AxoRPC:AxoRPCTests",
        "//apple/AxoDaemonManager:AxoDaemonManagerTests",
        "//apple/AxoMac:AxoMacTests",
        "//apple/AxoMac:TerminalWorkbenchE2ETests",
        "//apple/AxoMac:AxoVisualUITests",
        "//apple/AxoMac:AxoAppSelfTestTests",
    ],
)
