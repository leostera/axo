load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcodeproj")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Info.plist",
    "Resources/dev.leostera.axo.axod.plist",
])

swift_library(
    name = "AxoMac",
    module_name = "AxoMac",
    srcs = glob(["Sources/AxoMac/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        "//apple/AxoDaemonManager:AxoDaemonManager",
        "//apple/AxoRPC:AxoRPC",
        "@ghostty//:GhosttyKit",
    ],
)

swift_test(
    name = "AxoMacTests",
    srcs = ["Tests/AxoMacTests/TerminalLayoutTests.swift"],
    copts = ["-swift-version", "5"],
    deps = [":AxoMac"],
)

swift_test(
    name = "AxoAppSelfTestTests",
    srcs = ["Tests/AxoMacTests/TerminalAppE2ETests.swift"],
    copts = ["-swift-version", "5"],
    data = [":AxoApp"],
    env = {
        "AXO_APP_BUNDLE_ZIP": "$(rootpath :AxoApp)",
    },
    tags = ["no-sandbox"],
    timeout = "short",
)

apple_bundle_version(
    name = "build_version",
    build_label_pattern = "axo_build_{build}",
    build_version = "{build}",
    capture_groups = {"build": "[0-9]+"},
    fallback_build_label = "axo_build_3",
    short_version_string = "0.1.0",
)

genrule(
    name = "launch_agent_plist",
    srcs = ["Resources/dev.leostera.axo.axod.plist"],
    outs = ["dev.leostera.axo.axod.plist"],
    cmd = "cp $(location Resources/dev.leostera.axo.axod.plist) $@",
)

macos_application(
    name = "AxoApp",
    bundle_id = "dev.leostera.axo",
    bundle_name = "Axo",
    executable_name = "Axo",
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    version = ":build_version",
    additional_contents = {
        ":launch_agent_plist": "Library/LaunchAgents",
        "//crates/axod:axod": "Helpers",
        "@ghostty//:resources": "Resources",
        "@ghostty//:terminfo": "Resources",
    },
    deps = [":AxoMac"],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "AxoMac",
    tags = ["manual"],
    top_level_targets = [
        ":AxoApp",
        "//apple/AxoRPC:AxoRPCTests",
        "//apple/AxoDaemonManager:AxoDaemonManagerTests",
        "//apple/AxoMac:AxoMacTests",
        "//apple/AxoMac:AxoAppSelfTestTests",
    ],
)
