load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_apple//apple:macos.bzl", "macos_application", "macos_ui_test", "macos_unit_test")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("@axo_config//:defs.bzl", "AXO", "CAN", "MACHINE")
load("//bazel/apple:defs.bzl", "mac_app_install", "signed_mac_app")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Info.plist",
    "AxoUITest-Info.plist",
    "Resources/dev.leostera.axo.axod.plist",
    "Resources/dev.leostera.axo.app.plist",
])

AXO_MAC_DEPS = [
    "//apple/AxoRubber",
    "//apple/AxoSquishy",
    "//apple/AxoDaemonManager:AxoDaemonManager",
    "//apple/AxoProtocol",
    "//apple/AxoClient:AxoClient",
    "//apple/AxoMascot",
    "//apple/AxoSearch:AxoSearch",
    "@ghostty//:GhosttyKit",
]

# All app code, compiled once and shared by the shipped app, the fixture app and unit tests.
swift_library(
    name = "AxoMac",
    module_name = "AxoMac",
    srcs = glob(["Sources/AxoMac/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = AXO_MAC_DEPS,
)

# The mascot's Rive player. Kept out of AxoMac: RiveRuntime is a dynamic framework, which
# swift_test cannot load, so only app bundles and macos_unit_test link it.
swift_library(
    name = "AxoMascotRive",
    module_name = "AxoMascotRive",
    srcs = glob(["Sources/AxoMascotRive/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [":AxoMac", "//apple/AxoMascot", "@swiftpkg_rive_ios//:RiveRuntime"],
)

# The shipped app's @main entry: production launch only.
swift_library(
    name = "AxoMacMain",
    module_name = "AxoMacMain",
    srcs = glob(["Sources/AxoMacMain/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [":AxoMac", ":AxoMascotRive"],
)

# The fixture app's @main entry plus self-test and UI-automation launch modes, for
# AxoUITestApp only. Uses `@testable import AxoMac`, so it builds in non-optimized modes only.
swift_library(
    name = "AxoMacTestHost",
    module_name = "AxoMacTestHost",
    srcs = glob(["Sources/AxoMacTestHost/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = AXO_MAC_DEPS + [":AxoMac"],
)

swift_test(
    name = "AxoMacTests",
    srcs = glob(
        ["Tests/AxoMacTests/*.swift"],
        # These need a live daemon, packaged app or UI runner; see their own targets.
        exclude = [
            "Tests/AxoMacTests/TerminalAppE2ETests.swift",
            "Tests/AxoMacTests/TerminalWorkbenchE2ETests.swift",
        ],
    ),
    copts = ["-swift-version", "5"],
    data = ["Resources/dev.leostera.axo.axod.plist"],
    env = {"AXO_LAUNCH_AGENT_PLIST": "$(rootpath Resources/dev.leostera.axo.axod.plist)"},
    deps = [":AxoMac"],
)

swift_library(
    name = "AxoMascotRiveTestsLib",
    testonly = True,
    srcs = glob(["Tests/AxoMascotRiveTests/*.swift"]),
    copts = ["-swift-version", "5"],
    # Bundled into the test bundle's resources.
    data = ["//assets:mascot"],
    deps = [":AxoMascotRive", "@swiftpkg_rive_ios//:RiveRuntime"],
)

# Plays the generated assets/mascot/axo.riv in the real Rive runtime (Metal required).
macos_unit_test(
    name = "AxoMascotRiveTests",
    bundle_id = AXO["apple"]["bundle_ids"]["mac_mascot_tests"],
    minimum_os_version = AXO["apple"]["macos_min"],
    deps = [":AxoMascotRiveTestsLib"],
)

swift_test(
    name = "TerminalWorkbenchE2ETests",
    srcs = ["Tests/AxoMacTests/TerminalWorkbenchE2ETests.swift"],
    copts = ["-swift-version", "5"],
    data = [
        "//crates/axo-server:pi_extension_fixture",
        "//crates/axod:axod",
        "//crates/axod:testdata/pi-fixture.sh",
    ],
    env = {
        "AXOD_TEST_BINARY": "$(rootpath //crates/axod:axod)",
        "AXO_PI_EXTENSION_PATH": "$(rootpath //crates/axo-server:pi_extension_fixture)",
        "AXO_TEST_PI_EXECUTABLE": "$(rootpath //crates/axod:testdata/pi-fixture.sh)",
    },
    deps = [
        ":AxoMac",
        "//apple/AxoDaemonManager",
    ],
    # Each test starts its own axod fixture, so shards run in parallel; rules_swift's runner
    # assigns tests to shards round-robin.
    shard_count = 3,
    tags = ["no-sandbox"],
    timeout = "moderate",
)

swift_library(
    name = "AxoVisualUITestsLib",
    testonly = True,
    srcs = glob(["Tests/AxoVisualUITests/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [":AxoMac"],
)

macos_ui_test(
    name = "AxoVisualUITests",
    bundle_id = AXO["apple"]["bundle_ids"]["mac_visual_tests"],
    minimum_os_version = AXO["apple"]["macos_min"],
    test_host = ":AxoUITestApp",
    resources = ["//crates/axod:axod"],
    deps = [":AxoVisualUITestsLib"],
    tags = ["manual", "no-sandbox"],
    timeout = "long",
)

sh_test(
    name = "AxoVisualUITestsBazel",
    srcs = ["run_visual_ui_test.sh"],
    data = ["//apple:xcodeproj", "//:MODULE.bazel", "//crates/axod:axod"],
    env = {
        "AXO_UI_AXOD_RUNFILE": "$(rlocationpath //crates/axod:axod)",
        "AXO_XCODEPROJ_RUNNER": "$(rlocationpath //apple:xcodeproj)",
        "AXO_WORKSPACE_MODULE": "$(rlocationpath //:MODULE.bazel)",
    },
    env_inherit = [
        "AXO_UI_TEST_ONLY",
        "BAZEL_REAL",
        "BAZELISK_SKIP_WRAPPER",
        "DEVELOPER_DIR",
        "HOME",
        "PATH",
        "TMPDIR",
    ],
    # It drives the real desktop: run it by name, with Axo closed and the screen unlocked.
    tags = [
        "manual",
        "no-sandbox",
        "requires-mac-ui",
    ],
    timeout = "long",
    target_compatible_with = ["@platforms//os:macos"],
)

swift_test(
    name = "AxoAppSelfTestTests",
    srcs = ["Tests/AxoMacTests/TerminalAppE2ETests.swift"],
    copts = ["-swift-version", "5"],
    data = [
        ":AxoUITestApp",
        "//crates/axo-server:pi_extension_fixture",
        "//crates/axod:testdata/pi-fixture.sh",
    ],
    env = {
        "AXO_APP_BUNDLE_ZIP": "$(rootpath :AxoUITestApp)",
        "AXO_PI_EXTENSION_PATH": "$(rootpath //crates/axo-server:pi_extension_fixture)",
        "AXO_TEST_PI_EXECUTABLE": "$(rootpath //crates/axod:testdata/pi-fixture.sh)",
    },
    tags = ["no-sandbox"],
    timeout = "short",
)

# The app's version and build number come from config.json (RFD0021).
apple_bundle_version(
    name = "build_version",
    build_version = str(AXO["builds"]["mac"]),
    short_version_string = AXO["version"],
)

genrule(
    name = "launch_agent_plist",
    srcs = ["Resources/dev.leostera.axo.axod.plist"],
    outs = ["dev.leostera.axo.axod.plist"],
    cmd = "cp $(location Resources/dev.leostera.axo.axod.plist) $@",
)

# Axo's own LaunchAgent: back at login and after a crash, not after Quit Axo.
genrule(
    name = "app_agent_plist",
    srcs = ["Resources/dev.leostera.axo.app.plist"],
    outs = ["dev.leostera.axo.app.plist"],
    cmd = "cp $(location Resources/dev.leostera.axo.app.plist) $@",
)

# The Pi extension axod loads from Contents/Resources/AxoPi.
copy_to_directory(
    name = "AxoPi",
    srcs = ["//packages/pi-axo:extension_js"],
    root_paths = ["packages/pi-axo/dist"],
)

config_setting(
    name = "apple_silicon_inference",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
)

_APP_CONTENTS = {
    ":launch_agent_plist": "Library/LaunchAgents",
    ":app_agent_plist": "Library/LaunchAgents",
    "//crates/axod/release": "Helpers",
    "@llama_server//:axod-infer": "Helpers",
    "//crates/axod-infer/release:coreml": "Helpers",
    ":AxoPi": "Resources/AxoPi",
    "@ghostty//:resources": "Resources",
    "@ghostty//:terminfo": "Resources",
}

macos_application(
    name = "AxoApp",
    app_icons = ["//assets:macos_app_icon"],
    resources = ["//assets:mascot"],
    bundle_id = AXO["apple"]["bundle_ids"]["mac"],
    bundle_name = "Axo",
    executable_name = "Axo",
    infoplists = ["Info.plist", "@axo_config//:mac.plist"],
    minimum_os_version = AXO["apple"]["macos_min"],
    version = ":build_version",
    additional_contents = select({
        ":apple_silicon_inference": _APP_CONTENTS | {
            "//crates/axod-infer/release": "Helpers",
            "@mlx//:mlx.metallib": "Resources/MLX",
            "@mlx//:MLX-third-party-notices.txt": "Resources/ThirdParty",
        },
        "//conditions:default": _APP_CONTENTS,
    }),
    deps = [":AxoMacMain"],
)

# The app as it ships: signed for launchd with this Mac's identity for the team in config.json, or
# ad hoc when there is none (RFD0021).
signed_mac_app(
    name = "Axo",
    app = ":AxoApp",
    identity = MACHINE.signing_identity or "",
)

# Puts it at config.json's dist.mac_app (dist/Axo.app) on every build that changes it.
mac_app_install(
    name = "dist",
    app = ":Axo",
    destination = MACHINE.workspace + "/" + AXO["dist"]["mac_app"],
)

# What `bazel run //:publish` uploads.
genrule(
    name = "Axo_zip",
    srcs = [":Axo"],
    outs = ["Axo.app.zip"],
    # ditto keeps the bundle's symlinks, permissions and signature intact.
    cmd = "/usr/bin/ditto -c -k --sequesterRsrc --keepParent $(execpath :Axo) $@",
    # In the sandbox the bundle's files are symlinks, which ditto would zip as symlinks.
    tags = ["no-sandbox"],
)

sh_test(
    name = "package_test",
    srcs = ["//bazel/apple:package_test.sh"],
    args = [
        "$(rootpath :Axo)",
        str(AXO["builds"]["mac"]),
        str(AXO["builds"]["axod"]),
        AXO["apple"]["macos_min"],
        AXO["apple"]["team"] if CAN.sign else "-",
    ] + select({
        ":apple_silicon_inference": ["mlx"],
        "//conditions:default": [],
    }),
    data = [":Axo"],
    # codesign must see the bundle itself, not the sandbox's per-file symlinks to it.
    tags = ["no-sandbox"],
)

macos_application(
    name = "AxoUITestApp",
    bundle_id = AXO["apple"]["bundle_ids"]["mac_ui_tests"],
    bundle_name = "Axo",
    executable_name = "Axo",
    infoplists = ["AxoUITest-Info.plist"],
    minimum_os_version = AXO["apple"]["macos_min"],
    version = ":build_version",
    additional_contents = {
        ":launch_agent_plist": "Library/LaunchAgents",
        "//crates/axod:axod": "Helpers",
        "@ghostty//:resources": "Resources",
        "@ghostty//:terminfo": "Resources",
    },
    deps = [":AxoMacTestHost"],
)
