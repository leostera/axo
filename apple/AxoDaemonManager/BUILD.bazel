load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "AxoDaemonManager",
    module_name = "AxoDaemonManager",
    srcs = glob(["Sources/AxoDaemonManager/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        "//apple/AxoProtocol",
        "//apple/AxoRPC:AxoRPC",
    ],
)

swift_test(
    name = "AxoDaemonManagerTests",
    srcs = glob(["Tests/AxoDaemonManagerTests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [":AxoDaemonManager"],
)
