load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application", "ios_ui_test")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("@axo_config//:defs.bzl", "AXO")

package(default_visibility = ["//visibility:public"])

exports_files(["Info.plist", "AxoPhone.entitlements", "AxoPhone-device.entitlements"])

# The phone's state and rules: no UIKit, so the same code builds for iOS and is tested on macOS.
swift_library(
    name = "AxoPhoneModel",
    module_name = "AxoPhoneModel",
    srcs = glob(["Sources/AxoPhoneModel/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        "//apple/AxoClient",
        "//apple/AxoProtocol",
    ],
)

swift_test(
    name = "AxoPhoneModelTests",
    srcs = glob(["Tests/AxoPhoneModelTests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        ":AxoPhoneModel",
        "//apple/AxoClient",
        "//apple/AxoProtocol",
    ],
)

# The SwiftUI screens: sign in with Access, your Macs, one Mac's Sessions and terminal.
swift_library(
    name = "AxoPhone",
    module_name = "AxoPhone",
    srcs = glob(["Sources/AxoPhone/**/*.swift"]),
    copts = ["-swift-version", "5"],
    # UIKit-backed SwiftUI: only the iOS apps build it, through their platform transition.
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":AxoPhoneModel",
        "//apple/AxoClient",
        "//apple/AxoMascot",
        "//apple/AxoProtocol",
        "@swiftpkg_rive_ios//:RiveRuntime",
    ],
)

swift_library(
    name = "AxoPhoneMain",
    module_name = "AxoPhoneMain",
    srcs = glob(["Sources/AxoPhoneMain/*.swift"]),
    copts = ["-swift-version", "5"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [":AxoPhone"],
)

ios_application(
    name = "AxoPhoneApp",
    app_icons = ["//assets:ios_app_icon"],
    bundle_id = AXO["apple"]["bundle_ids"]["phone"],
    entitlements = "AxoPhone.entitlements",
    # iPhone only, as the original app was.
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = AXO["apple"]["ios_min"],
    resources = ["//assets:mascot", "//assets:fonts"],
    version = ":build_version",
    deps = [":AxoPhoneMain"],
)

# The app driven as a person would, against its simulator preview:
# `bazel test //apple/AxoPhone:AxoPhoneUITests --ios_multi_cpus=sim_arm64`.
swift_library(
    name = "AxoPhoneUITestsLib",
    testonly = True,
    srcs = glob(["UITests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    module_name = "AxoPhoneUITests",
)

ios_xctestrun_runner(
    name = "AxoPhoneUITestRunner",
    device_type = AXO["apple"]["simulator"]["device"],
    os_version = AXO["apple"]["simulator"]["os"],
)

ios_ui_test(
    name = "AxoPhoneUITests",
    minimum_os_version = AXO["apple"]["ios_min"],
    runner = ":AxoPhoneUITestRunner",
    tags = ["manual"],
    test_host = ":AxoPhoneApp",
    # Some thirty tests that each launch the app (about fifteen minutes) take longer than "long".
    timeout = "eternal",
    deps = [":AxoPhoneUITestsLib"],
)

# The phone app's version and build number come from config.json, counted apart from the Mac
# app's (RFD0021).
apple_bundle_version(
    name = "build_version",
    build_version = str(AXO["builds"]["phone"]),
    short_version_string = AXO["version"],
)

# The profile Xcode made for this app id (it appears in ~/Library/Developer/Xcode/UserData/
# Provisioning Profiles the first time Xcode signs the app automatically; or download one from the
# developer portal). Only a Mac that has it builds the device target.

local_provisioning_profile(
    name = "AxoPhoneProfile",
    profile_name = AXO["apple"]["phone_profile"],
    team_id = AXO["apple"]["team"],
)

# The same app, signed for a phone: `bazel build //apple/AxoPhone:AxoPhoneDevice --ios_multi_cpus=arm64`,
# or Run on a device from the Xcode project.
ios_application(
    name = "AxoPhoneDevice",
    app_icons = ["//assets:ios_app_icon"],
    bundle_id = AXO["apple"]["bundle_ids"]["phone"],
    entitlements = "AxoPhone-device.entitlements",
    # iPhone only, as the original app was.
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = AXO["apple"]["ios_min"],
    resources = ["//assets:mascot", "//assets:fonts"],
    version = ":build_version",
    provisioning_profile = ":AxoPhoneProfile",
    tags = ["manual"],
    deps = [":AxoPhoneMain"],
)
