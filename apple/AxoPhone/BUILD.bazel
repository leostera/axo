load("@rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@rules_apple//apple:ios.bzl", "ios_application", "ios_ui_test")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("@axo_config//:defs.bzl", "AXO", "CAN", "REASONS")
load("//bazel/apple:defs.bzl", "ios_device_app", "phone_install", "status_line")

package(default_visibility = ["//visibility:public"])

exports_files(["Info.plist", "AxoPhone.entitlements", "AxoPhone-device.entitlements"])

# The phone's state and rules: no UIKit, so the same code builds for iOS and is tested on macOS.
swift_library(
    name = "AxoPhoneModel",
    module_name = "AxoPhoneModel",
    srcs = glob(["Sources/AxoPhoneModel/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        "//apple/AxoClient",
        "//apple/AxoProtocol",
    ],
)

swift_test(
    name = "AxoPhoneModelTests",
    srcs = glob(
        ["Tests/AxoPhoneModelTests/**/*.swift"],
        exclude = ["Tests/AxoPhoneModelTests/EndToEndTests.swift"],
    ),
    copts = ["-swift-version", "5"],
    deps = [
        ":AxoPhoneModel",
        "//apple/AxoClient",
        "//apple/AxoProtocol",
    ],
)

# The phone's model and client against a real Worker relaying to a real axod.
swift_test(
    name = "AxoPhoneEndToEndTests",
    srcs = [
        "Tests/AxoPhoneModelTests/EndToEndTests.swift",
        "Tests/AxoPhoneModelTests/MemoryTokenStore.swift",
    ],
    copts = ["-swift-version", "5"],
    data = [
        "//crates/axod",
        "//packages/axo-api-worker:e2e_stack",
    ],
    env = {
        "AXO_E2E_AXOD": "$(rootpath //crates/axod)",
        "AXO_E2E_STACK": "$(rootpath //packages/axo-api-worker:e2e_stack)",
    },
    # axod's socket and the Worker's port, on this Mac.
    tags = ["no-sandbox"],
    deps = [
        ":AxoPhoneModel",
        "//apple/AxoClient",
        "//apple/AxoProtocol",
    ],
)

# The SwiftUI screens: sign in with Access, your Macs, one Mac's Sessions and terminal.
swift_library(
    name = "AxoPhone",
    module_name = "AxoPhone",
    srcs = glob(["Sources/AxoPhone/**/*.swift"]),
    copts = ["-swift-version", "5"],
    # UIKit-backed SwiftUI: only the iOS apps build it, through their platform transition.
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":AxoPhoneModel",
        "//apple/AxoClient",
        "//apple/AxoMascot",
        "//apple/AxoProtocol",
        "@swiftpkg_rive_ios//:RiveRuntime",
    ],
)

swift_library(
    name = "AxoPhoneMain",
    module_name = "AxoPhoneMain",
    srcs = glob(["Sources/AxoPhoneMain/*.swift"]),
    copts = ["-swift-version", "5"],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [":AxoPhone"],
)

ios_application(
    name = "AxoPhoneApp",
    app_icons = ["//assets:ios_app_icon"],
    bundle_id = AXO["apple"]["bundle_ids"]["phone"],
    entitlements = "AxoPhone.entitlements",
    # iPhone only, as the original app was.
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = AXO["apple"]["ios_min"],
    resources = ["//assets:mascot", "//assets:fonts"],
    version = ":build_version",
    deps = [":AxoPhoneMain"],
)

# The app driven as a person would, against its simulator preview:
# `bazel test //apple/AxoPhone:AxoPhoneUITests`.
swift_library(
    name = "AxoPhoneUITestsLib",
    testonly = True,
    srcs = glob(["UITests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    # The reviewed screenshots the visual tests compare against (UITests/Snapshots.swift).
    data = glob(["Snapshots/Phone/*.png"]),
    module_name = "AxoPhoneUITests",
)

ios_xctestrun_runner(
    name = "AxoPhoneUITestRunner",
    device_type = AXO["apple"]["simulator"]["device"],
    os_version = AXO["apple"]["simulator"]["os"],
)

ios_ui_test(
    name = "AxoPhoneUITests",
    minimum_os_version = AXO["apple"]["ios_min"],
    runner = ":AxoPhoneUITestRunner",
    tags = ["manual"],
    test_host = ":AxoPhoneApp",
    # Some thirty tests that each launch the app (about fifteen minutes) take longer than "long".
    timeout = "eternal",
    deps = [":AxoPhoneUITestsLib"],
)

# The phone app's version and build number come from config.json, counted apart from the Mac
# app's (RFD0021).
apple_bundle_version(
    name = "build_version",
    build_version = str(AXO["builds"]["phone"]),
    short_version_string = AXO["version"],
)

# The profile Xcode made for this app id (it appears in ~/Library/Developer/Xcode/UserData/
# Provisioning Profiles the first time Xcode signs the app automatically; or download one from the
# developer portal). Only a Mac that has it builds the device target.

# Only a Mac with the phone's provisioning profile can sign the app for a phone; elsewhere the
# device targets are a line in the build report (RFD0021).
local_provisioning_profile(
    name = "AxoPhoneProfile",
    profile_name = AXO["apple"]["phone_profile"],
    team_id = AXO["apple"]["team"],
) if CAN.phone_device else None

# The same app, signed for a phone and built for arm64 in every build. Xcode's Run on a device uses
# it too.
ios_application(
    name = "AxoPhoneDevice",
    app_icons = ["//assets:ios_app_icon"],
    bundle_id = AXO["apple"]["bundle_ids"]["phone"],
    entitlements = "AxoPhone-device.entitlements",
    # iPhone only, as the original app was.
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = AXO["apple"]["ios_min"],
    resources = ["//assets:mascot", "//assets:fonts"],
    version = ":build_version",
    provisioning_profile = ":AxoPhoneProfile",
    # Built through :AxoPhone_ipa, which picks the phone's CPU.
    tags = ["manual"],
    deps = [":AxoPhoneMain"],
) if CAN.phone_device else None

ios_device_app(
    name = "AxoPhone_ipa",
    app = ":AxoPhoneDevice",
) if CAN.phone_device else status_line(
    name = "AxoPhone_ipa",
    line = "AxoPhoneDevice: skipped: " + REASONS.get("phone_device", ""),
)

# Installs and opens each new device build on the phone in config.local.json (phone.device), when
# phone.install is set; the build report says what happened.
phone_install(
    name = "install",
    app = ":AxoPhone_ipa" if CAN.phone_device else None,
    bundle_id = AXO["apple"]["bundle_ids"]["phone"],
    device = AXO.get("phone", {}).get("device", ""),
    off = REASONS.get("phone_install", ""),
)

# bazel run //apple/AxoPhone:record_snapshots: after reviewing them, the last UI test run's
# screenshots become the baselines the visual tests compare against.
sh_binary(
    name = "record_snapshots",
    srcs = ["record_snapshots.sh"],
)
