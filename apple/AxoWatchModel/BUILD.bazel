load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "AxoWatchModel",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AxoWatchModel",
    copts = ["-swift-version", "5"],
    deps = [
        "//apple/AxoClient",
        "//apple/AxoPhone:AxoPhoneModel",
        "//apple/AxoProtocol",
    ],
)

swift_test(
    name = "AxoWatchModelTests",
    srcs = glob(["Tests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        ":AxoWatchModel",
        "//apple/AxoClient",
        "//apple/AxoPhone:AxoPhoneModel",
        "//apple/AxoProtocol",
    ],
)
