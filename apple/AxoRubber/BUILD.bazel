load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# Axo in the menu bar, made of rubber: a LiquidFun soft body behind a small C interface, which
# Swift imports as `AxoRubber`.
cc_library(
    name = "AxoRubber",
    srcs = ["src/axo_rubber.cpp"],
    hdrs = ["include/axo_rubber.h"],
    aspect_hints = [":module"],
    copts = ["-O2", "-std=c++17"],
    strip_include_prefix = "include",
    deps = ["//third_party/liquidfun"],
)

swift_interop_hint(
    name = "module",
    module_name = "AxoRubber",
)

swift_test(
    name = "AxoRubberTests",
    srcs = ["Tests/AxoRubberTests.swift"],
    deps = [":AxoRubber"],
)
