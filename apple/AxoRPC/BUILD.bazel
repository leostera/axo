load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Package.resolved",
    "Package.swift",
])

swift_library(
    name = "AxoRPC",
    module_name = "AxoRPC",
    srcs = glob(["Sources/AxoRPC/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        "//apple/AxoProtocol",
        "@swiftpkg_jsonrpc//:JSONRPC",
    ],
)

swift_test(
    name = "AxoDaemonInteropTests",
    srcs = glob(["Tests/AxoRPCDaemonInteropTests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    data = ["//crates/axod:axod"],
    env = {"AXOD_BINARY": "$(rootpath //crates/axod:axod)"},
    tags = ["no-sandbox"],
    timeout = "short",
    deps = [
        ":AxoRPC",
        "//apple/AxoProtocol",
    ],
)

swift_test(
    name = "AxoRPCTests",
    srcs = glob(["Tests/AxoRPCTests/**/*.swift"]),
    copts = ["-swift-version", "5"],
    deps = [
        ":AxoRPC",
        "//apple/AxoProtocol",
    ],
)
