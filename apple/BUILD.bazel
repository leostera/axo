load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcodeproj")
load("@axo_config//:defs.bzl", "CAN", "MACHINE")
load("//bazel/apple:defs.bzl", "xcodeproj_install")

# apple/Package.swift lists every remote Swift package; MODULE.bazel resolves them from here.
exports_files([
    "Package.swift",
    "Package.resolved",
])

# One Xcode project for every Apple package and app, apple/Axo.xcodeproj (generated, not checked
# in). Bazel stays the build; Xcode drives it.
xcodeproj(
    name = "xcodeproj",
    project_name = "Axo",
    # The Mac's native dependencies need host tools such as CMake and Ninja.
    bazel_env = {"PATH": None},
    tags = ["manual"],
    top_level_targets = [
        "//apple/AxoMac:AxoApp",
        "//apple/AxoPhone:AxoPhoneApp",
        "//apple/AxoWatch:AxoWatchApp",
        "//apple/AxoPhone:AxoPhoneModelTests",
        "//apple/AxoMac:AxoUITestApp",
        "//apple/AxoProtocol:AxoProtocolTests",
        "//apple/AxoClient:AxoClientTests",
        "//apple/AxoClient:AxoClientDaemonInteropTests",
        "//apple/AxoSearch:AxoSearchTests",
        "//apple/AxoMascot:AxoMascotTests",
        "//apple/AxoDaemonManager:AxoDaemonManagerTests",
        "//apple/AxoMac:AxoMacTests",
        "//apple/AxoMac:TerminalWorkbenchE2ETests",
        "//apple/AxoMac:AxoVisualUITests",
        "//apple/AxoMac:AxoAppSelfTestTests",
    ] + (["//apple/AxoPhone:AxoPhoneDevice"] if CAN.phone_device else []),
    visibility = ["//apple:__subpackages__"],
)

# Every build writes apple/Axo.xcodeproj, as `bazel run //apple:xcodeproj` does, when the files under
# apple/ change or the project is missing (RFD0021).
xcodeproj_install(
    name = "xcodeproj_install",
    # The project holds the tests.
    testonly = True,
    bazel = MACHINE.bazel or "",
    home = MACHINE.home,
    runner = ":xcodeproj",
    visibility = ["//:__pkg__"],
    retry = MACHINE.retry_dir + "/xcodeproj",
    workspace = MACHINE.workspace,
)
