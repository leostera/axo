load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])

# The squishy 3D Axo's body: a Bullet soft body behind a small C interface, which Swift imports
# as `AxoSquishy`.
cc_library(
    name = "AxoSquishy",
    srcs = ["src/axo_squishy.cpp"],
    hdrs = ["include/axo_squishy.h"],
    aspect_hints = [":module"],
    copts = ["-O2", "-std=c++17"],
    strip_include_prefix = "include",
    deps = ["//third_party/bullet"],
)

swift_interop_hint(
    name = "module",
    module_name = "AxoSquishy",
)
