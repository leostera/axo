load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")

package(default_visibility = ["//visibility:public"])

# Asset catalogs for the apps' `app_icons`. Generated by make-icons.swift; see README.md.
filegroup(
    name = "ios_app_icon",
    srcs = glob(["ios/Assets.xcassets/AppIcon.appiconset/**"]),
)

filegroup(
    name = "macos_app_icon",
    srcs = glob(["macos/Assets.xcassets/AppIcon.appiconset/**"]),
)

# The animated axolotl for the apps; generated by packages/axo-mascot (npm run build).
filegroup(
    name = "mascot",
    srcs = ["mascot/axo.riv"],
)

# The "axo" wordmark's font: Fredoka (variable; the app uses Bold), SIL Open Font License 1.1
# (see the OFL beside it).
filegroup(
    name = "fonts",
    srcs = ["fonts/Fredoka.ttf", "fonts/Fredoka-OFL.txt"],
)

# The mascot for JavaScript tests, which read it from the output tree.
js_library(
    name = "mascot_js",
    srcs = ["mascot/axo.riv"],
)

# @axo/assets: what the web app imports (the mascot, the wordmark's font).
npm_package(
    name = "pkg",
    srcs = [
        "fonts/Fredoka-OFL.txt",
        "fonts/Fredoka.ttf",
        "mascot/axo.riv",
        "package.json",
    ],
)
