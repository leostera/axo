 			int32 a = pair.indexA;
@@ -3601,6 +3601,18 @@
 			b2Vec2 d = pb - pa;
 			float32 r0 = pair.distance;
 			float32 r1 = d.Length();
+			if (m_def.springBreak > 0 &&
+				r1 > m_particleDiameter * m_def.springBreak * pair.strength)
+			{
+				pair.flags &= ~b2_springParticle;
+				continue;
