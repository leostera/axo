 	float32 springStrength = step.inv_dt * m_def.springStrength;
 	for (int32 k = 0; k < m_pairBuffer.GetCount(); k++)
 	{
-		const b2ParticlePair& pair = m_pairBuffer[k];
+		b2ParticlePair& pair = m_pairBuffer[k];
 		if (pair.flags & b2_springParticle)
