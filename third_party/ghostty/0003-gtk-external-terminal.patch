 /// True if the surface requires confirmation to quit. This should be called
 /// by apprt to determine if the surface should confirm before quitting.
 pub fn needsConfirmQuit(self: *Surface) bool {
+    // Closing an externally owned terminal is detach, never process termination.
+    if (comptime @hasDecl(apprt.runtime.Surface, "externalIo")) {
+        if (self.rt_surface.externalIo() != null) return false;
+    }
     // If the surface is in read-only mode, always require confirmation
     if (self.readonly) return true;
 
