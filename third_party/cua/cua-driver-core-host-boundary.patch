+    /// Remove tools at the canonical dispatch boundary, not just from advertised schemas.
+    pub fn retain_tools(&mut self, allowed: &[&str]) {
+        self.tools.retain(|name, _| allowed.contains(&name.as_str()));
+        let mut seen = std::collections::HashSet::new();
+        self.order.retain(|name| allowed.contains(&name.as_str()) && seen.insert(name.clone()));
+    }
+
+    /// Install a host-owned guard before publishing the registry in an Arc.
+    pub fn set_invocation_guard(&mut self, guard: InvocationGuard) {
+        self.invocation_guard = Some(guard);
+    }
