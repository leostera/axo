diff --git a/packages/coding-agent/test/suite/agent-session-resume-turn.test.ts b/packages/coding-agent/test/suite/agent-session-resume-turn.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..73e00bc50d9a10fadc56a814dce8d7de9d116b95
--- /dev/null
+++ b/packages/coding-agent/test/suite/agent-session-resume-turn.test.ts
@@ -0,0 +1,172 @@
+import type { AgentTool } from "@earendil-works/pi-agent-core";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it } from "vitest";
+import type { ExtensionAPI } from "../../src/core/extensions/types.ts";
+import { createHarness, type Harness } from "./harness.ts";
+
+const harnesses: Harness[] = [];
+afterEach(() => {
+	while (harnesses.length) harnesses.pop()?.cleanup();
+});
+function seedUser(h: Harness): void {
+	h.sessionManager.appendMessage({
+		role: "user",
+		content: [{ type: "text", text: "original request" }],
+		timestamp: 1,
+	});
+}
+
+describe("message-free resumeTurn", () => {
+	it("starts from restored context with normal hooks and no synthetic message", async () => {
+		const starts: string[] = [];
+		const h = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_agent_start", (event) => {
+						starts.push(event.messageType);
+					});
+				},
+			],
+		});
+		harnesses.push(h);
+		seedUser(h);
+		h.setResponses([
+			(context) => {
+				expect(context.messages.filter((m) => m.role === "user")).toHaveLength(1);
+				expect(JSON.stringify(context.messages)).toContain("original request");
+				expect(context.messages.map((m) => m.role)).not.toContain("custom");
+				return fauxAssistantMessage("continued");
+			},
+		]);
+		await h.session.resumeTurn();
+		expect(starts).toEqual(["resume"]);
+		expect(h.sessionManager.getEntries().filter((e) => e.type === "custom_message")).toHaveLength(0);
+		expect(h.session.messages.filter((m) => m.role === "user")).toHaveLength(1);
+		expect(h.eventsOfType("agent_settled")).toHaveLength(1);
+	});
+
+	it("does not re-execute a saved completed tool call", async () => {
+		let executions = 0;
+		const tool: AgentTool = {
+			name: "effect",
+			label: "Effect",
+			description: "A test effect",
+			parameters: Type.Object({}),
+			execute: async () => {
+				executions++;
+				return { content: [{ type: "text", text: "unexpected" }], details: {} };
+			},
+		};
+		const h = await createHarness({ tools: [tool] });
+		harnesses.push(h);
+		seedUser(h);
+		const call = fauxToolCall("effect", {});
+		h.sessionManager.appendMessage(fauxAssistantMessage(call, { stopReason: "toolUse" }));
+		h.sessionManager.appendMessage({
+			role: "toolResult",
+			toolCallId: call.id,
+			toolName: "effect",
+			content: [{ type: "text", text: "already completed" }],
+			isError: false,
+			timestamp: 2,
+		});
+		h.setResponses([
+			(context) => {
+				expect(context.messages.filter((m) => m.role === "toolResult")).toHaveLength(1);
+				return fauxAssistantMessage("used saved result");
+			},
+		]);
+		await h.session.resumeTurn();
+		expect(executions).toBe(0);
+	});
+
+	it("supports extension-side continuation without a hidden custom trigger", async () => {
+		let api: ExtensionAPI | undefined;
+		const h = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					api = pi;
+				},
+			],
+		});
+		harnesses.push(h);
+		seedUser(h);
+		h.setResponses([fauxAssistantMessage("continued")]);
+		api!.resumeTurn();
+		await h.session.waitForIdle();
+		expect(h.session.messages.map((m) => m.role)).toEqual(["user", "system", "assistant"]);
+		expect(h.sessionManager.getEntries().some((e) => e.type === "custom_message")).toBe(false);
+	});
+
+	it("refuses empty context without adding any entry", async () => {
+		const h = await createHarness();
+		harnesses.push(h);
+		const before = h.sessionManager.getEntries();
+		await expect(h.session.resumeTurn()).rejects.toThrow("No messages to resume");
+		expect(h.sessionManager.getEntries()).toEqual(before);
+		expect(h.session.isIdle).toBe(true);
+	});
+
+	it("reserves the run while start hooks await, refuses duplicates and honors abort", async () => {
+		let entered = () => {};
+		let release = () => {};
+		const started = new Promise<void>((resolve) => {
+			entered = resolve;
+		});
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const h = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_agent_start", async () => {
+						entered();
+						await gate;
+					});
+				},
+			],
+		});
+		harnesses.push(h);
+		seedUser(h);
+		h.setResponses([fauxAssistantMessage("must not complete")]);
+		const running = h.session.resumeTurn();
+		await started;
+		await expect(h.session.resumeTurn()).rejects.toThrow("already processing");
+		const aborting = h.session.abort();
+		release();
+		await Promise.all([running, aborting]);
+		const last = h.session.messages.at(-1);
+		expect(last?.role === "assistant" && last.stopReason).toBe("aborted");
+		expect(h.session.messages.filter((message) => message.role === "user")).toHaveLength(1);
+		expect(h.session.isIdle).toBe(true);
+	});
+
+	it("keeps normal tool interception and post-run settlement", async () => {
+		const h = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "blocked",
+						label: "Blocked",
+						description: "Must be blocked",
+						parameters: Type.Object({}),
+						execute: async () => {
+							throw new Error("must never execute");
+						},
+					});
+					pi.on("tool_call", () => ({ block: true, reason: "normal safety gate" }));
+				},
+			],
+		});
+		harnesses.push(h);
+		seedUser(h);
+		h.setResponses([
+			fauxAssistantMessage(fauxToolCall("blocked", {}), { stopReason: "toolUse" }),
+			fauxAssistantMessage("gate honored"),
+		]);
+		await h.session.resumeTurn();
+		expect(h.session.messages.some((m) => m.role === "toolResult" && m.isError)).toBe(true);
+		expect(h.eventsOfType("agent_settled")).toHaveLength(1);
+	});
+});
