load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])
exports_files(["native/build.zig", "native/bridge.zig"])

rust_binary(
    name = "AxoDesktop",
    crate_name = "axo_desktop",
    srcs = ["src/main.rs", "src/ghostty.rs", "src/attachment.rs", "src/catalog_task.rs", "src/task.rs", "src/settings.rs", "src/style.rs", "src/tray.rs", "src/workbench.rs", "src/workbench/actions.rs", "src/workbench/wake.rs", "src/workbench/panes.rs", "src/viewport_task.rs", "src/options_tests.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    deps = ["//crates/axo-client:axo_client", "//crates/axo-protocol:axo_protocol", "//crates/axo-pty:axo_pty", "@crates//:gtk4", "@crates//:serde_json", "@crates//:tokio", "@crates//:clap"],
    link_deps = ["@ghostty_gtk//:bridge"],
    compile_data = ["//assets:brand_catalog"],
    data = ["@ghostty_gtk//:runtime"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_binary(
    name = "run",
    srcs = ["run.sh"],
    args = ["$(rlocationpath :AxoDesktop)", "$(rlocationpath @ghostty_gtk//:runtime.marker)"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
    data = [":AxoDesktop", "@ghostty_gtk//:runtime", "@ghostty_gtk//:runtime.marker"],
    target_compatible_with = ["@platforms//os:linux"],
)

rust_test(
    name = "unit_tests",
    crate = ":AxoDesktop",
    edition = "2024",
    target_compatible_with = ["@platforms//os:linux"],
)
