load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# @axo/api-worker: the Worker and its Durable Objects, imported by the site as source.
npm_package(
    name = "pkg",
    srcs = ["package.json"] + glob(["src/**/*.ts"]),
)

_DEPS = [
    ":node_modules/@axo/app",
    ":node_modules/@axo/apps",
    ":node_modules/@axo/protocol",
    ":node_modules/@cfworker/json-schema",
    ":node_modules/@leostera/atxf",
    ":node_modules/@modelcontextprotocol/sdk",
    ":node_modules/@types/node",
    ":node_modules/@types/ws",
    ":node_modules/esbuild",
    ":node_modules/fast-check",
    ":node_modules/hono",
    ":node_modules/jose",
    ":node_modules/miniflare",
    ":node_modules/ws",
    ":node_modules/zod",
]

# no_emit puts the compiler check in its own output group, not DefaultInfo.
# Make the public gate actually run tsc rather than merely copy its inputs.
filegroup(
    name = "typecheck",
    srcs = [":typecheck_project"],
    output_group = "typecheck",
)

ts_project(
    name = "typecheck_project",
    srcs = glob(["src/**/*.ts", "tests/**/*.ts", "testing/**/*.ts", "scripts/**/*.ts"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    # tsconfig.json includes the site's generated runtime types (cloudflare:workers, Request, ...);
    # Env is src/env.d.ts, the bindings this Worker uses.
    deps = _DEPS + [
        ":node_modules/@axo/pi-axo",
        "//sites/axo.leostera.dev:worker_runtime_types",
    ],
)

_RELAY_TESTS = [
    "tests/axod-relay.test.ts",
    "tests/phone-path.test.ts",
    "tests/apps-e2e.test.ts",
    "tests/axod-peers.test.ts",
    "tests/elicitations-e2e.test.ts",
    "tests/attachments-e2e.test.ts",
]

# Every file the tests read, copied to the output tree by an untagged target (see node_test).
js_library(
    name = "test_files",
    # package.json says the sources are ES modules; Baileys' crypto (through @axo/apps) can only be imported as one.
    srcs = ["package.json"] + glob(["src/**/*.ts", "tests/**", "testing/**"]),
)

# The Worker in Miniflare, with fake identity providers, apps and hosts.
node_test(
    name = "test",
    concurrency = 1,
    data = _DEPS + [
        ":node_modules/tsx",
        ":node_modules/@axo/pi-axo",
        ":test_files",
        "//packages/axo-api:fixtures",
    ],
    tests = glob(
        ["tests/*.test.ts"],
        exclude = _RELAY_TESTS + ["tests/ai-e2e.test.ts"],
    ),
    tests_in_data = True,
    # About 4 minutes alone, one file at a time; the default 5 is too close under a full run.
    timeout = "long",
    tsx = True,
)

# Focused run-budget/dispatcher tests without waiting for the entire provider suite.
node_test(
    name = "run_limits_test",
    concurrency = 1,
    data = _DEPS + [":node_modules/tsx", ":test_files"],
    tests = ["tests/gateway.test.ts", "tests/run-scope.test.ts", "tests/mcp-client.test.ts", "tests/third-party.test.ts"],
    tests_in_data = True,
    tsx = True,
)

# APNs protocol tests use ephemeral signing keys and an injected transport, never real devices.
node_test(
    name = "apns_test",
    data = _DEPS + [":node_modules/tsx", ":test_files"],
    tests = ["tests/apns.test.ts", "tests/apns-registration.test.ts", "tests/apns-feedback.test.ts", "tests/rich-notifications.test.ts"],
    concurrency = 1,
    tests_in_data = True,
    tsx = True,
)

node_test(
    name = "notify_test",
    concurrency = 1,
    data = _DEPS + [":node_modules/tsx", ":test_files"],
    tests = ["tests/rich-notifications.test.ts", "tests/apps.test.ts", "tests/gateway.test.ts"],
    tests_in_data = True,
    tsx = True,
)

# A Mac revoking the credential it stopped using (RFD0074).
node_test(
    name = "host_credential_test",
    concurrency = 1,
    data = _DEPS + [":node_modules/tsx", ":test_files"],
    tests = ["tests/host-credential.test.ts"],
    tests_in_data = True,
    tsx = True,
)

# Focused person-request fanout across relayed and direct clients.
node_test(
    name = "elicitations_test",
    concurrency = 1,
    data = _DEPS + [":node_modules/tsx", ":test_files"],
    tests = ["tests/elicitations.test.ts", "tests/push-delivery.test.ts"],
    tests_in_data = True,
    tags = ["manual"],
    tsx = True,
)

# Focused limits on what a caller may make the cloud hold or do: fragments, shares, rate limits.
node_test(
    name = "limits_test",
    concurrency = 1,
    data = _DEPS + [":node_modules/tsx", ":node_modules/@axo/pi-axo", ":test_files"],
    tests = ["tests/client-fragments.test.ts", "tests/fragments.test.ts", "tests/rate-limits.test.ts", "tests/share.test.ts"],
    tests_in_data = True,
    tsx = True,
)

# Focused watchOS HTTPS mailbox integration tests (no client WebSockets).
node_test(
    name = "http_test",
    concurrency = 1,
    data = _DEPS + [
        ":node_modules/tsx",
        ":test_files",
    ],
    tests = ["tests/http-client.test.ts"],
    tests_in_data = True,
    tsx = True,
)

# The Worker relaying to a real axod, as the Mac and the phone use it.
node_test(
    name = "relay_test",
    concurrency = 1,
    data = _DEPS + [
        ":node_modules/tsx",
        ":test_files",
        "//crates/axo-server:pi_extension_fixture_js",
        "//crates/axod",
        "//crates/axod:pi_fixture_js",
    ],
    # Relative to the package, where node_test runs.
    env = {"AXOD_BINARY": "../../crates/axod/axod"},
    tags = ["no-sandbox"],
    tests = _RELAY_TESTS,
    tests_in_data = True,
    tsx = True,
)

config_setting(
    name = "apple_silicon_inference",
    constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"],
)

config_setting(
    name = "macos_inference",
    constraint_values = ["@platforms//os:macos"],
)

# Explicit opt-in: real HF models/tasks through codemode, without production deployment.
node_test(
    name = "ai_smoke_test",
    timeout = "long",
    concurrency = 1,
    data = _DEPS + [
        ":node_modules/tsx",
        ":test_files",
        "//crates/axod",
    ] + select({
        ":apple_silicon_inference": ["//crates/axod-infer:axod-infer-mlx"],
        "//conditions:default": [],
    }) + select({
        ":macos_inference": ["//crates/axod-infer:axod-infer-coreml"],
        "//conditions:default": [],
    }),
    env = {"AXOD_BINARY": "../../crates/axod/axod"},
    tags = ["manual", "no-sandbox"],
    tests = ["tests/ai-e2e.test.ts"],
    tests_in_data = True,
    tsx = True,
)

# A Worker relaying to a real axod, for the phone's end-to-end test (//apple/AxoMobile:AxoMobileEndToEndTests).
# AXOD_BINARY is set by whoever runs it.
js_binary(
    name = "e2e_stack",
    testonly = True,
    chdir = package_name(),
    data = _DEPS + [
        ":node_modules/tsx",
        ":test_files",
        "//crates/axo-server:pi_extension_fixture_js",
    ],
    entry_point = "scripts/e2e-stack.ts",
    node_options = [
        "--import",
        "tsx",
    ],
    visibility = ["//apple/AxoMobile:__pkg__"],
)
