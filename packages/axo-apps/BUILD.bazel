load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# @axo/apps: each app's sign-in, API hosts and tools (RFD0016), imported as TypeScript source.
npm_package(
    name = "pkg",
    srcs = ["bundling.d.mts", "bundling.mjs", "package.json"] + glob(["src/**/*.ts"]),
)

_DEPS = [
    ":node_modules/@axo/protocol",
    ":node_modules/@discordjs/rest",
    ":node_modules/@octokit/core",
    ":node_modules/@octokit/plugin-paginate-rest",
    ":node_modules/@octokit/plugin-rest-endpoint-methods",
    ":node_modules/baileys",
    ":node_modules/discord-api-types",
    ":node_modules/big-integer",
    ":node_modules/oauth4webapi",
    ":node_modules/telegram",
    ":node_modules/zod",
]

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts", "tests/**/*.ts"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = _DEPS + [":node_modules/@types/node"],
)

node_test(
    name = "test",
    # package.json says the sources are ES modules; Baileys' crypto can only be imported as one.
    data = ["package.json"] + glob(["src/**/*.ts"]) + _DEPS + [":node_modules/tsx"],
    tests = glob(["tests/*.test.ts"]),
    tsx = True,
)
