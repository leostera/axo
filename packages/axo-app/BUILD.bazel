load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# @axo/app: the browser API and remote terminal transport, imported as TypeScript source.
npm_package(
    name = "pkg",
    srcs = ["package.json"] + glob(["src/**/*.ts"]),
)

_DEPS = [
    ":node_modules/@axo/protocol",
    ":node_modules/@hpke/core",
    ":node_modules/zod",
]

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = _DEPS,
)

node_test(
    name = "test",
    data = glob(["src/**/*.ts"]) + _DEPS + [":node_modules/tsx", "//crates/axo-seal:vectors"],
    tests = glob(["test/*.test.mjs"]),
    # Node strips types only outside node_modules, where Bazel links @axo/protocol.
    tsx = True,
)
