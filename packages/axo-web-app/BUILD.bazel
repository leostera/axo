load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

_SRCS = glob(["src/**"])

# @axo/web-app: the web app the site serves, imported as source.
npm_package(
    name = "pkg",
    srcs = ["package.json"] + _SRCS,
)

_DEPS = [
    ":node_modules/@axo/app",
    ":node_modules/@axo/assets",
    ":node_modules/@axo/protocol",
    ":node_modules/@rive-app/canvas",
    ":node_modules/@types/node",
    ":node_modules/@types/react",
    ":node_modules/@types/react-dom",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/vite",
]

# Vite's client types, which the site's typecheck includes too.
js_library(
    name = "vite_env",
    srcs = ["src/vite-env.d.ts"],
    deps = [":node_modules/vite"],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = _DEPS,
)

node_test(
    name = "test",
    data = _SRCS + _DEPS + [":node_modules/tsx"],
    tests = ["test/chat-model.test.ts"],
    tsx = True,
)

# The browser test's files, copied to the output tree by an untagged target (see node_test).
js_library(
    name = "browser_test_files",
    srcs = _SRCS + glob(["test/*.mjs"]),
)

# The app in Chrome against fixture APIs, served by Vite from the site.
node_test(
    name = "browser_test",
    concurrency = 1,
    data = _DEPS + [
        ":browser_test_files",
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/playwright-core",
        ":node_modules/ws",
        "//sites/axo.leostera.dev:app_files",
    ],
    tags = [
        "no-sandbox",
        "requires-browser",
    ],
    tests = [
        "test/browser.test.mjs",
        "test/shared-session.test.mjs",
    ],
    tests_in_data = True,
)
