load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

_SRCS = glob(["src/**"])

# @axo/web-app: the web app the site serves, imported as source.
npm_package(
    name = "pkg",
    srcs = ["package.json"] + _SRCS,
)

_DEPS = [
    ":node_modules/@axo/app",
    ":node_modules/@axo/assets",
    ":node_modules/@axo/protocol",
    ":node_modules/@rive-app/canvas",
    ":node_modules/@types/node",
    ":node_modules/@types/qrcode",
    ":node_modules/@types/react",
    ":node_modules/@types/react-dom",
    ":node_modules/qrcode",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/vite",
]

# Vite's client types, which the site's typecheck includes too.
js_library(
    name = "vite_env",
    srcs = ["src/vite-env.d.ts"],
    deps = [":node_modules/vite"],
)

# no_emit puts the compiler check in its own output group, not DefaultInfo.
# Make the public gate actually run tsc rather than merely copy its inputs.
filegroup(
    name = "typecheck",
    srcs = [":typecheck_project"],
    output_group = "typecheck",
)

ts_project(
    name = "typecheck_project",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    no_emit = True,
    tsconfig = "tsconfig.json",
    deps = _DEPS,
)

node_test(
    name = "test",
    data = _SRCS + _DEPS + [":node_modules/tsx", "//crates/axo-seal:vectors"],
    tests = ["test/chat-model.test.ts"],
    tsx = True,
)

# The browser test's files, copied to the output tree by an untagged target (see node_test).
js_library(
    name = "browser_test_files",
    srcs = _SRCS + glob(["test/*.mjs"]),
)

_BROWSER_DATA = _DEPS + [
    ":browser_test_files",
    ":node_modules/@vitejs/plugin-react",
    ":node_modules/playwright-core",
    ":node_modules/ws",
    "//sites/axo.leostera.dev:app_files",
]

node_test(
    name = "jump_browser_test",
    concurrency = 1,
    data = _BROWSER_DATA,
    tags = ["manual", "no-sandbox", "requires-browser"],
    tests = ["test/jump-to-latest.test.mjs"],
    tests_in_data = True,
)

# One focused media/approval flow for fast interaction regressions; also in the full suite below.
node_test(
    name = "elicitations_browser_test",
    concurrency = 1,
    data = _BROWSER_DATA,
    tags = ["manual", "no-sandbox", "requires-browser"],
    tests = ["test/elicitations.test.mjs"],
    tests_in_data = True,
)

node_test(
    name = "sidebar_browser_test",
    concurrency = 1,
    data = _BROWSER_DATA,
    tags = ["manual", "no-sandbox", "requires-browser"],
    tests = ["test/web-polish.test.mjs"],
    tests_in_data = True,
)

node_test(
    name = "slash_browser_test",
    concurrency = 1,
    data = _BROWSER_DATA,
    tags = ["manual", "no-sandbox", "requires-browser"],
    tests = ["test/slash-menu.test.mjs"],
    tests_in_data = True,
)

node_test(
    name = "composer_browser_test",
    concurrency = 1,
    data = _BROWSER_DATA,
    tags = ["manual", "no-sandbox", "requires-browser"],
    tests = ["test/composer-pills.test.mjs"],
    tests_in_data = True,
)

# The app in Chrome against fixture APIs, served by Vite from the site.
node_test(
    name = "browser_test",
    concurrency = 1,
    data = _BROWSER_DATA,
    tags = [
        "no-sandbox",
        "requires-browser",
    ],
    tests = [
        "test/browser.test.mjs",
        "test/composer-pills.test.mjs",
        "test/chat-list.test.mjs",
        "test/cache.test.mjs",
        "test/web-polish.test.mjs",
        "test/conversation.test.mjs",
        "test/shared-session.test.mjs",
        "test/slash-menu.test.mjs",
        "test/tools.test.mjs",
        "test/queued-messages.test.mjs",
        "test/jump-to-latest.test.mjs",
        "test/elicitations.test.mjs",
    ],
    tests_in_data = True,
)
