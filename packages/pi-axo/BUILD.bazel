load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//:tsconfig_base"],
)

ts_config(
    name = "tsconfig_tests",
    src = "tsconfig.tests.json",
    deps = [":tsconfig"],
)

_DEPS = [
    ":node_modules/@earendil-works/pi-coding-agent",
    ":node_modules/@earendil-works/pi-ai",
    ":node_modules/@earendil-works/pi-tui",
    ":node_modules/@types/node",
    ":node_modules/typebox",
]

# The Pi extension axod loads: dist/*.js, which the Mac app bundles in Resources/AxoPi.
ts_project(
    name = "pi-axo",
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = True,
    tsconfig = ":tsconfig",
    deps = _DEPS,
)

# What the Mac app bundles in Contents/Resources/AxoPi: the compiled JavaScript only.
filegroup(
    name = "extension_js",
    srcs = ["dist/%s.js" % src[len("src/"):-len(".ts")] for src in glob(["src/*.ts"])],
)

ts_project(
    name = "typecheck_tests",
    srcs = glob(["src/**/*.ts", "test/**/*.ts"]),
    no_emit = True,
    out_dir = "dist",
    tsconfig = ":tsconfig_tests",
    deps = _DEPS,
)

node_test(
    name = "test",
    # package.json makes the sources ES modules, so packages that only export `import`
    # (@earendil-works/pi-ai) resolve when a test imports them at run time.
    data = ["package.json"] + glob(["src/**/*.ts", "test/**/*"]) + _DEPS + [":node_modules/tsx"],
    tests = glob(["test/*.test.ts"]),
    tsx = True,
)

# @axo/pi-axo as a workspace package: the Worker's share test imports @axo/pi-axo/share.
npm_package(
    name = "pkg",
    srcs = ["package.json"] + glob(["src/**/*.ts"]),
)
