{
  "name": "@axo/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Axo RPC contracts and schema validation",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js",
      "default": "./dist/v1.js"
    }
  },
  "files": ["dist", "fixtures", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema:check": "npm run build && node scripts/check-schemas.mjs",
    "test": "npm run build && npm run schema:check"
  },
  "dependencies": {
    "json-rpc-2.0": "1.8.1",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  }
}
