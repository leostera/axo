load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/js:defs.bzl", "node_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# AXP's documents, schemas and examples: what sites/axp.leostera.dev renders.
js_library(
    name = "spec",
    srcs = [
        "PRODUCT.md",
        "README.md",
        "SPEC.md",
    ] + glob([
        "examples/*",
        "extensions/*.md",
        "schema/**/*.json",
    ]),
)

# The documents, schemas and examples agree: every message validates, every hash, chain and
# signature checks out, and every documented method has a schema.
node_test(
    name = "test",
    data = [
        ":node_modules/@leostera/atxf",
        ":node_modules/ajv",
        ":node_modules/ajv-formats",
        ":spec",
    ],
    tests = glob(["tests/*.test.mjs"]),
)
