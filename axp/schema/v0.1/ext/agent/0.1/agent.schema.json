{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axp.leostera.dev/schema/v0.1/ext/agent/0.1/agent.schema.json",
  "title": "AXP extension `agent` 0.1",
  "description": "Steering the agent that runs in a Session. See extensions/agent.md.",
  "$defs": {
    "agent.prompt.params": {
      "allOf": [
        {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/command"
        }
      ],
      "type": "object",
      "properties": {
        "hostId": true,
        "generation": true,
        "from": true,
        "commandId": true,
        "sessionId": {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/uuid"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "https://axp.leostera.dev/schema/v0.1/ext/assets/0.1/assets.schema.json#/$defs/attachment"
          },
          "maxItems": 8
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "sessionId",
        "text"
      ],
      "if": {
        "properties": {
          "text": {
            "maxLength": 0
          }
        }
      },
      "then": {
        "required": [
          "attachments"
        ],
        "properties": {
          "attachments": {
            "minItems": 1
          }
        }
      }
    },
    "agent.prompt.result": {
      "allOf": [
        {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/receipt"
        }
      ],
      "type": "object",
      "properties": {
        "receipt": true,
        "duplicate": true
      },
      "unevaluatedProperties": false
    },
    "agent.stop.params": {
      "allOf": [
        {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/command"
        }
      ],
      "type": "object",
      "properties": {
        "hostId": true,
        "generation": true,
        "from": true,
        "commandId": true,
        "sessionId": {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/uuid"
        },
        "turn": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "sessionId",
        "turn"
      ]
    },
    "agent.stop.result": {
      "allOf": [
        {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/receipt"
        }
      ],
      "type": "object",
      "properties": {
        "receipt": true,
        "duplicate": true,
        "stopped": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    },
    "agent.restart.params": {
      "allOf": [
        {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/command"
        }
      ],
      "type": "object",
      "properties": {
        "hostId": true,
        "generation": true,
        "from": true,
        "commandId": true,
        "sessionId": {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/uuid"
        },
        "mode": {
          "enum": [
            "auto",
            "force"
          ]
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "sessionId",
        "mode"
      ]
    },
    "agent.restart.result": {
      "allOf": [
        {
          "$ref": "https://axp.leostera.dev/schema/v0.1/axp.schema.json#/$defs/receipt"
        }
      ],
      "type": "object",
      "properties": {
        "receipt": true,
        "duplicate": true
      },
      "unevaluatedProperties": false
    },
    "slot.reply": {
      "description": "An ATXF message record without hash.",
      "$ref": "https://atxf.leostera.dev/schema/v0.1/atxf.schema.json#/$defs/messageRecord"
    },
    "slot.tool": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "error",
            "cancelled"
          ]
        },
        "output": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    }
  }
}
